     1	//! Finder collaboration commands (G3-E3).
     2	//!
     3	//! Three minimal user-initiated path actions:
     4	//!
     5	//! - `reveal_in_finder` — opens a Finder window highlighting the path.
     6	//! - `open_path` — opens the path in its default handler (file → app).
     7	//! - `remove_item_from_grid` — pure logical removal; does NOT touch the
     8	//!   user's filesystem. The Organizer plugin owns the "send file to
     9	//!   Trash" decision and must surface a confirmation UI before invoking
    10	//!   any future destructive variant.
    11	//!
    12	//! All commands enforce a window-origin allow-list and validate the path
    13	//! against the user-reachable root allow-list (see `validate_user_path`)
    14	//! before touching the platform layer.
    15	
    16	use std::path::{Component, Path, PathBuf};
    17	
    18	use serde::Deserialize;
    19	
    20	use crate::error::{AppError, AppResult};
    21	
    22	const FINDER_ALLOWED_WINDOWS: &[&str] = &["main", "control", "console"];
    23	
    24	/// User-reachable filesystem roots a desktop file/app drop or open-panel
    25	/// selection can produce on macOS. Paths outside these roots are rejected
    26	/// for now — full bookmark-store enforcement is a later gate. On non-macOS
    27	/// targets only `/tmp/` is admitted, mirroring the existing macOS-only
    28	/// behavior of the platform commands.
    29	#[cfg(target_os = "macos")]
    30	const USER_REACHABLE_ROOTS: &[&str] = &["/Users/", "/Applications/", "/Volumes/", "/tmp/"];
    31	
    32	#[cfg(not(target_os = "macos"))]
    33	const USER_REACHABLE_ROOTS: &[&str] = &["/tmp/"];
    34	
    35	fn is_finder_window_allowed(label: &str) -> bool {
    36	    if FINDER_ALLOWED_WINDOWS.contains(&label) {
    37	        return true;
    38	    }
    39	    label.starts_with("grid_")
    40	}
    41	
    42	fn ensure_finder_window_allowed(label: &str) -> AppResult<()> {
    43	    if is_finder_window_allowed(label) {
    44	        return Ok(());
    45	    }
    46	    Err(AppError::SyncCapabilityDenied(format!(
    47	        "window `{label}` is not allowed to invoke Finder commands"
    48	    )))
    49	}
    50	
    51	/// Validate `raw` looks like a user-authorized absolute path and return its
    52	/// lexically-normalized canonical form.
    53	///
    54	/// Rules:
    55	/// - rejects empty / NUL / whitespace-only input.
    56	/// - rejects relative paths and any `..` parent-dir segment (even when the
    57	///   raw string would normalize away, e.g. `/Users/me/../etc/passwd`).
    58	/// - rejects paths whose normalized form does NOT start with one of the
    59	///   allowed user-reachable roots (`/Users/`, `/Applications/`, `/Volumes/`,
    60	///   `/tmp/` on macOS; only `/tmp/` on other targets).
    61	///
    62	/// Returns the normalized `PathBuf` on success. This is a *lexical*
    63	/// normalization (`Path::components`) rather than `canonicalize()` because
    64	/// `canonicalize` requires the path to exist on disk; that stricter check
    65	/// is a follow-up once a bookmark store lands.
    66	pub(crate) fn validate_user_path(raw: &str) -> AppResult<PathBuf> {
    67	    if raw.trim().is_empty() {
    68	        return Err(AppError::SyncInvalidInput(
    69	            "path must be non-empty".into(),
    70	        ));
    71	    }
    72	    if raw.contains('\0') {
    73	        return Err(AppError::SyncInvalidInput(
    74	            "path must not contain NUL".into(),
    75	        ));
    76	    }
    77	
    78	    let path = Path::new(raw);
    79	    if !path.is_absolute() {
    80	        return Err(AppError::SyncInvalidInput(format!(
    81	            "path must be absolute: `{raw}`"
    82	        )));
    83	    }
    84	
    85	    // Walk components, refusing any `..` (parent) segment. This catches
    86	    // both `/Users/me/../etc/passwd` and `/Applications/../etc/passwd`.
    87	    let mut normalized = PathBuf::new();
    88	    for component in path.components() {
    89	        match component {
    90	            Component::ParentDir => {
    91	                return Err(AppError::SyncInvalidInput(format!(
    92	                    "path must not contain `..` segments: `{raw}`"
    93	                )));
    94	            }
    95	            Component::CurDir => {
    96	                // Drop `.` — harmless lexical no-op.
    97	            }
    98	            other => normalized.push(other.as_os_str()),
    99	        }
   100	    }
   101	
   102	    let normalized_str = normalized.to_string_lossy().to_string();
   103	    let under_allowed_root = USER_REACHABLE_ROOTS
   104	        .iter()
   105	        .any(|root| normalized_str.starts_with(root));
   106	
   107	    if !under_allowed_root {
   108	        return Err(AppError::SyncCapabilityDenied(format!(
   109	            "path `{normalized_str}` is not under a user-reachable root"
   110	        )));
   111	    }
   112	
   113	    Ok(normalized)
   114	}
