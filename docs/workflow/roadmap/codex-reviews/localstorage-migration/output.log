     1	/**
     2	 * Legacy `xai-desktop-layout` localStorage blob → Repository v0 migration.
     3	 *
     4	 * The Organizer originally serialised the entire desktop layout as one JSON
     5	 * blob (`{ grids: GridBox[], items: DesktopItem[] }`) under the key
     6	 * `xai-desktop-layout`. G2.3 splits that blob into typed Repository v0
     7	 * records — `GridEntity` per grid and `GridItemEntity` per item.
     8	 *
     9	 * Guarantees:
    10	 *
    11	 * - **Idempotent.** Running the migration twice produces the same repo
    12	 *   state; the second run is a no-op upsert.
    13	 * - **Non-destructive by default.** The legacy key is kept in
    14	 *   `localStorage` unless the caller passes `removeLegacy: true`, so the
    15	 *   user can roll back if SQLite is unavailable.
    16	 * - **Pure data transform.** No Tauri / no React; safe to call from
    17	 *   either side of the IPC boundary.
    18	 */
    19	
    20	import { assertRepoRecord } from "./repo-utils";
    21	import type {
    22	  GridEntity,
    23	  GridItemEntity,
    24	} from "./entities";
    25	import type { Repo } from "./types";
    26	import type { StorageLike } from "./local-storage";
    27	
    28	export const LEGACY_LAYOUT_STORAGE_KEY = "xai-desktop-layout";
    29	
    30	/** Minimal shape of a record inside the legacy `grids[]` array. */
    31	export interface LegacyGridBox {
    32	  id: string;
    33	  title: string;
    34	  rect: { x: number; y: number; width: number; height: number };
    35	  isLocked?: boolean;
    36	  isFolded?: boolean;
    37	  viewMode?: "grid" | "list";
    38	  itemIds?: string[];
    39	  themeColor?: string;
    40	}
    41	
    42	/** Minimal shape of a record inside the legacy `items[]` array. */
    43	export interface LegacyDesktopItem {
    44	  id: string;
    45	  filename: string;
    46	  filepath: string;
    47	  type: "file" | "folder" | "app";
    48	  icon: string;
    49	  size?: number;
    50	  createdAt?: number;
    51	}
    52	
    53	export interface LegacyOrganizerLayout {
    54	  grids: LegacyGridBox[];
    55	  items: LegacyDesktopItem[];
    56	}
    57	
    58	export interface OrganizerLayoutMigrationOptions {
    59	  storage: StorageLike;
    60	  gridRepo: Repo<GridEntity>;
    61	  itemRepo: Repo<GridItemEntity>;
    62	  legacyKey?: string;
    63	  nowIso?: () => string;
    64	  removeLegacy?: boolean;
    65	}
    66	
    67	export interface OrganizerLayoutMigrationResult {
    68	  scanned: boolean;
    69	  parsed: boolean;
    70	  gridsMigrated: number;
    71	  itemsMigrated: number;
    72	  removedLegacy: boolean;
    73	}
    74	
    75	export async function migrateOrganizerLayoutToRepos(
    76	  options: OrganizerLayoutMigrationOptions,
    77	): Promise<OrganizerLayoutMigrationResult> {
    78	  const legacyKey = options.legacyKey ?? LEGACY_LAYOUT_STORAGE_KEY;
    79	  const raw = options.storage.getItem(legacyKey);
    80	  if (raw === null) {
    81	    return emptyResult();
    82	  }
    83	
    84	  let layout: LegacyOrganizerLayout;
    85	  try {
    86	    layout = JSON.parse(raw) as LegacyOrganizerLayout;
    87	  } catch {
    88	    return { ...emptyResult(), scanned: true };
    89	  }
    90	
    91	  if (
    92	    !layout ||
    93	    !Array.isArray(layout.grids) ||
    94	    !Array.isArray(layout.items)
    95	  ) {
    96	    return { ...emptyResult(), scanned: true };
    97	  }
    98	
    99	  const nowIso = options.nowIso ?? (() => new Date().toISOString());
   100	  const timestamp = nowIso();
   101	
   102	  let gridsMigrated = 0;
   103	  for (const legacyGrid of layout.grids) {
   104	    if (!legacyGrid || typeof legacyGrid.id !== "string") continue;
   105	    const record = toGridEntity(legacyGrid, timestamp);
   106	    assertRepoRecord(record);
   107	    await options.gridRepo.put(record);
   108	    gridsMigrated += 1;
   109	  }
   110	
   111	  let itemsMigrated = 0;
   112	  for (const legacyItem of layout.items) {
   113	    if (!legacyItem || typeof legacyItem.id !== "string") continue;
   114	    const gridId = findOwningGridId(legacyItem.id, layout.grids);
   115	    if (!gridId) continue;
   116	    const record = toGridItemEntity(legacyItem, gridId, timestamp);
   117	    assertRepoRecord(record);
   118	    await options.itemRepo.put(record);
   119	    itemsMigrated += 1;
   120	  }
   121	
   122	  let removedLegacy = false;
   123	  if (options.removeLegacy) {
   124	    options.storage.removeItem(legacyKey);
   125	    removedLegacy = true;
   126	  }
   127	
   128	  return {
   129	    scanned: true,
   130	    parsed: true,
   131	    gridsMigrated,
   132	    itemsMigrated,
   133	    removedLegacy,
   134	  };
   135	}
   136	
   137	function emptyResult(): OrganizerLayoutMigrationResult {
   138	  return {
   139	    scanned: false,
   140	    parsed: false,
   141	    gridsMigrated: 0,
   142	    itemsMigrated: 0,
   143	    removedLegacy: false,
   144	  };
   145	}
   146	
   147	function toGridEntity(
   148	  legacy: LegacyGridBox,
   149	  timestamp: string,
   150	): GridEntity {
   151	  return {
   152	    id: legacy.id,
   153	    entityType: "organizer.grid",
   154	    schemaVersion: 1,
   155	    createdAt: timestamp,
   156	    updatedAt: timestamp,
   157	    syncScope: "account-sync",
   158	    title: legacy.title ?? "Untitled",
   159	    rect: {
   160	      x: numberOrZero(legacy.rect?.x),
   161	      y: numberOrZero(legacy.rect?.y),
   162	      width: numberOrDefault(legacy.rect?.width, 240),
   163	      height: numberOrDefault(legacy.rect?.height, 320),
   164	    },
   165	    isLocked: Boolean(legacy.isLocked),
   166	    isFolded: Boolean(legacy.isFolded),
   167	    viewMode: legacy.viewMode === "list" ? "list" : "grid",
   168	    itemIds: Array.isArray(legacy.itemIds) ? [...legacy.itemIds] : [],
   169	    themeColor: legacy.themeColor,
   170	  };
   171	}
   172	
   173	function toGridItemEntity(
   174	  legacy: LegacyDesktopItem,
   175	  gridId: string,
   176	  timestamp: string,
   177	): GridItemEntity {
   178	  const kind: GridItemEntity["kind"] = legacy.type ?? "file";
   179	  return {
   180	    id: legacy.id,
   181	    entityType: "organizer.item",
   182	    schemaVersion: 1,
   183	    createdAt: timestamp,
   184	    updatedAt: timestamp,
   185	    syncScope: "account-sync",
   186	    gridId,
   187	    filename: legacy.filename ?? legacy.id,
   188	    filepath: legacy.filepath,
   189	    kind,
   190	    icon: legacy.icon ?? "doc",
   191	    size: legacy.size,
   192	  };
   193	}
   194	
   195	function findOwningGridId(
   196	  itemId: string,
   197	  grids: LegacyGridBox[],
   198	): string | undefined {
   199	  for (const grid of grids) {
   200	    if (Array.isArray(grid.itemIds) && grid.itemIds.includes(itemId)) {
   201	      return grid.id;
   202	    }
   203	  }
   204	  return undefined;
   205	}
   206	
   207	function numberOrZero(value: unknown): number {
   208	  return typeof value === "number" && Number.isFinite(value) ? value : 0;
   209	}
   210	
   211	function numberOrDefault(value: unknown, fallback: number): number {
   212	  return typeof value === "number" && Number.isFinite(value) ? value : fallback;
   213	}

