     1	import { MouseEvent as ReactMouseEvent, useCallback } from "react";
     2	import { getCurrentWindow } from "@tauri-apps/api/window";
     3	import { OrganizerGridContent } from "@repo/plugin-organizer";
     4	import { GlobalDndProvider } from "../providers/DndProvider";
     5	import { SettingsProvider, useSettings } from "../context/SettingsContext";
     6	
     7	const DRAG_THRESHOLD_PX = 4;
     8	
     9	/**
    10	 * Native Grid window shell.
    11	 *
    12	 * Host owns provider wiring and AppKit drag handoff. Organizer owns the Grid
    13	 * content, item rendering, drop semantics, and cross-window state events.
    14	 */
    15	function GridWindowShell({ gridId }: { gridId: string }) {
    16	  const { gridOpacity, gridBlur } = useSettings();
    17	
    18	  // Intercept mousedown on the Organizer title bar (or the G0 fallback
    19	  // panel) in CAPTURE phase. We stopPropagation so react-draggable's
    20	  // onMouseDown synthetic handler never fires — its DOM-drag is meaningless
    21	  // in multi-window mode and emits bogus rect.x/y that warp the window. Past
    22	  // DRAG_THRESHOLD_PX we hand off to Tauri startDragging, which drives the
    23	  // window from AppKit's mouse-drag loop and gives unrestricted screen-wide
    24	  // movement (same pattern as the AI cube in 7b7ff35).
    25	  const handleHeaderDragStart = useCallback((event: ReactMouseEvent<HTMLDivElement>) => {
    26	    if (event.button !== 0) return;
    27	    const target = event.target as HTMLElement | null;
    28	    if (!target) return;
    29	
    30	    const onGridDragHandle =
    31	      Boolean(target.closest(".grid-title-bar")) ||
    32	      Boolean(target.closest("[data-g0-grid-prototype]"));
    33	    if (!onGridDragHandle) return;
    34	
    35	    // Don't hijack interactive children: buttons (lock/fold/view/close/etc.),
    36	    // the title edit input, the rename span's dblclick, or the resize handles.
    37	    if (target.closest("button, input, select, textarea, .resize-handle")) return;
    38	
    39	    event.preventDefault();
    40	    event.stopPropagation();
    41	
    42	    const startScreenX = event.screenX;
    43	    const startScreenY = event.screenY;
    44	    let handed = false;
    45	
    46	    const cleanup = () => {
    47	      window.removeEventListener("mousemove", onMove, true);
    48	      window.removeEventListener("mouseup", onUp, true);
    49	    };
    50	
    51	    const onMove = (ev: MouseEvent) => {
    52	      if (handed) return;
    53	      const dx = ev.screenX - startScreenX;
    54	      const dy = ev.screenY - startScreenY;
    55	      if (Math.hypot(dx, dy) >= DRAG_THRESHOLD_PX) {
    56	        handed = true;
    57	        void getCurrentWindow()
    58	          .startDragging()
    59	          .catch((err) => {
    60	            console.error("[GridWindow] startDragging failed:", err);
    61	          });
    62	        cleanup();
    63	      }
    64	    };
    65	
    66	    const onUp = () => cleanup();
    67	
    68	    window.addEventListener("mousemove", onMove, true);
    69	    window.addEventListener("mouseup", onUp, true);
    70	  }, []);
    71	
    72	  return (
    73	    <div
    74	      onMouseDownCapture={handleHeaderDragStart}
    75	      style={{ width: "100%", height: "100%" }}
    76	    >
    77	      <OrganizerGridContent gridId={gridId} gridOpacity={gridOpacity} gridBlur={gridBlur} />
    78	    </div>
    79	  );
    80	}
    81	
    82	export function GridWindow({ gridId }: { gridId: string }) {
    83	  return (
    84	    <SettingsProvider>
    85	      <GlobalDndProvider>
    86	        <GridWindowShell gridId={gridId} />
    87	      </GlobalDndProvider>
    88	    </SettingsProvider>
    89	  );
    90	}
    91	
    92	export default GridWindow;

