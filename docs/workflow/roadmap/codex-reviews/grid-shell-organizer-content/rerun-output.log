     1	import { useEffect, useRef } from 'react';
     2	import { listen, TauriEvent } from '@tauri-apps/api/event';
     3	
     4	/**
     5	 * Re-export of Tauri's built-in event enum so plugins never need to import
     6	 * `@tauri-apps/api/event` directly (red-line #4).
     7	 */
     8	export { TauriEvent };
     9	
    10	/** Event handler signature exposed to plugins. */
    11	export type TauriEventHandler<T> = (event: { payload: T }) => void;
    12	
    13	/**
    14	 * Generic, untyped Tauri event listener hook.
    15	 *
    16	 * Use this when subscribing to:
    17	 *   - Built-in `TauriEvent` enum values (e.g. drag-drop lifecycle)
    18	 *   - Ad-hoc event names that are not yet codified in `@repo/core` `EventMap`
    19	 *
    20	 * For codified cross-window events, prefer `useEventListener` from
    21	 * `@repo/core/events`, which is constrained to `EventMap` keys.
    22	 *
    23	 * This is the ONLY place plugins are permitted to reach Tauri event IPC
    24	 * (red-line #4). Importing `@tauri-apps/api/event` directly from a plugin
    25	 * is a red-line #4 violation.
    26	 *
    27	 * The handler is read through a ref so callers may pass inline arrow
    28	 * functions without retriggering the subscription on every render. The
    29	 * subscription is established once per `event` (and per `enabled` flag).
    30	 */
    31	export function useTauriEvent<T>(
    32	  event: `${TauriEvent}` | (string & Record<never, never>),
    33	  handler: TauriEventHandler<T>,
    34	  options?: { enabled?: boolean },
    35	): void {
    36	  const enabled = options?.enabled ?? true;
    37	  const handlerRef = useRef(handler);
    38	
    39	  useEffect(() => {
    40	    handlerRef.current = handler;
    41	  }, [handler]);
    42	
    43	  useEffect(() => {
    44	    if (!enabled) return;
    45	    let cancelled = false;
    46	    let unlistenFn: (() => void) | null = null;
    47	
    48	    listen<T>(event, (e) => {
    49	      if (cancelled) return;
    50	      handlerRef.current(e);
    51	    }).then((fn) => {
    52	      if (cancelled) {
    53	        fn();
    54	        return;
    55	      }
    56	      unlistenFn = fn;
    57	    });
    58	
    59	    return () => {
    60	      cancelled = true;
    61	      if (unlistenFn) unlistenFn();
    62	    };
    63	  }, [event, enabled]);
    64	}

