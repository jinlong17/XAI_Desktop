     1	import { useMemo } from 'react';
     2	import { getCurrentWindow } from '@tauri-apps/api/window';
     3	
     4	/** Minimal physical position shape exposed to plugins. */
     5	export interface TauriWindowPosition {
     6	  x: number;
     7	  y: number;
     8	}
     9	
    10	/** Minimal physical size shape exposed to plugins. */
    11	export interface TauriWindowSize {
    12	  width: number;
    13	  height: number;
    14	}
    15	
    16	/**
    17	 * Plugin-facing handle to the current Tauri window.
    18	 *
    19	 * Wraps the Tauri `Window` instance so that plugins never need to import
    20	 * `@tauri-apps/api/window` directly (red-line #4). Surface area is kept
    21	 * intentionally small and only exposes the operations Organizer-class
    22	 * plugins currently require.
    23	 *
    24	 * Returned methods are stable identity for the lifetime of the host window
    25	 * because they delegate to the live Tauri window each call; consumers can
    26	 * safely depend on the returned object inside `useCallback` / `useEffect`
    27	 * without retriggering subscriptions.
    28	 */
    29	export interface TauriWindowHandle {
    30	  /** Unique window label assigned by Tauri (e.g. `main`, `grid_<id>`). */
    31	  readonly label: string;
    32	  /** Outer (top-left) position in physical pixels. */
    33	  outerPosition(): Promise<TauriWindowPosition>;
    34	  /** Inner size in physical pixels. */
    35	  innerSize(): Promise<TauriWindowSize>;
    36	  /** Closes the current window. */
    37	  close(): Promise<void>;
    38	  /** Emits an event on the Tauri global bus, scoped to this window. */
    39	  emit<T>(event: string, payload?: T): Promise<void>;
    40	  /** Emits an event targeted at a specific window label. */
    41	  emitTo<T>(target: string, event: string, payload?: T): Promise<void>;
    42	}
    43	
    44	/**
    45	 * Returns a stable handle to the current Tauri window for plugin code.
    46	 *
    47	 * This is the ONLY place plugins are permitted to reach Tauri window IPC
    48	 * (red-line #4). Importing `@tauri-apps/api/window` directly from a plugin
    49	 * is a red-line #4 violation.
    50	 *
    51	 * The hook does not perform any IPC on mount — calling code drives the
    52	 * lifecycle by invoking the returned methods on demand.
    53	 */
    54	export function useTauriWindow(): TauriWindowHandle {
    55	  return useMemo<TauriWindowHandle>(() => {
    56	    const current = getCurrentWindow();
    57	    return {
    58	      label: current.label,
    59	      async outerPosition() {
    60	        const position = await current.outerPosition();
    61	        return { x: position.x, y: position.y };
    62	      },
    63	      async innerSize() {
    64	        const size = await current.innerSize();
    65	        return { width: size.width, height: size.height };
    66	      },
    67	      async close() {
    68	        await current.close();
    69	      },
    70	      async emit<T>(event: string, payload?: T) {
    71	        await current.emit(event, payload);
    72	      },
    73	      async emitTo<T>(target: string, event: string, payload?: T) {
    74	        await current.emitTo(target, event, payload);
    75	      },
    76	    };
    77	  }, []);
    78	}

