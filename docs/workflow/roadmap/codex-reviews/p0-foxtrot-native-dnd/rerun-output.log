 aes-gcm       = { version = "=0.10.3",  optional = true }
 x25519-dalek  = { version = "=2.0.1",   optional = true, features = ["static_secrets", "getrandom"] }
 ed25519-dalek = { version = "=2.2.0",   optional = true }
 hpke          = { version = "=0.12.0",  optional = true }
