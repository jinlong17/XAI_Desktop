   117	/// Enforce honest user-authorized provenance for a finder action.
   118	///
   119	/// Two-stage gate:
   120	///
   121	/// 1. `validate_user_path` lexically normalizes and shape-checks the raw
   122	///    input (absolute, no `..`, under a user-reachable root).
   123	/// 2. `BookmarkRegistry` lookup asserts the user explicitly registered
   124	///    the canonical path through a prior drag-drop or open-panel action.
   125	///
   126	/// Stage 1 alone is NOT honest provenance — it only narrows the attack
   127	/// surface. The contract in `docs/contracts/tauri-commands-v0.md` §4
   128	/// requires that "all path access must come from user drop/open panel
   129	/// or authorized bookmark". This helper raises the implementation to
   130	/// match the contract.
   131	fn ensure_path_authorized(
   132	    raw: &str,
   133	    registry: &BookmarkRegistry,
   134	) -> AppResult<PathBuf> {
   135	    let canonical = validate_user_path(raw)?;
   136	    if !is_path_bookmarked(registry, &canonical) {
   137	        return Err(AppError::SyncCapabilityDenied(format!(
   138	            "path `{}` has no user-authorized bookmark",
   139	            canonical.display()
   140	        )));
   141	    }
   142	    Ok(canonical)
   143	}
