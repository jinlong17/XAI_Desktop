   204	export function getFileInfoFromPath(filePath: string): {
   205	  name: string;
   206	  extension: string;
   207	  type: 'file' | 'folder' | 'app';
   208	} {
   209	  const parts = filePath.split('/');
   210	  const name = parts[parts.length - 1] || 'Unknown';
   211	  const extension = name.includes('.') ? name.split('.').pop()?.toLowerCase() || '' : '';
   212	
   213	  // Determine type
   214	  let type: 'file' | 'folder' | 'app' = 'file';
   215	  if (extension === 'app') {
   216	    type = 'app';
   217	  } else if (!extension && !name.includes('.')) {
   218	    // No extension might be a folder (heuristic)
   219	    type = 'folder';
   220	  }
   221	
   222	  return { name, extension, type };
   223	}
