 [package]
 name = "desktop"
 version = "0.1.0"
 description = "A Tauri App"
 authors = ["you"]
 edition = "2021"
 license = "MIT"
 publish = false  # internal application binary; not published to crates.io
 
 # See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html
 
 [lib]
 # The `_lib` suffix may seem redundant but it is necessary
 # to make the lib name unique and wouldn't conflict with the bin name.
 # This seems to be only an issue on Windows, see https://github.com/rust-lang/cargo/issues/8519
 name = "desktop_lib"
 crate-type = ["staticlib", "cdylib", "rlib"]
 
 [build-dependencies]
 tauri-build = { version = "2", features = [] }
 
 [dependencies]
 tauri = { version = "2", features = ["macos-private-api", "tray-icon"] }
 tauri-plugin-opener = "2"
 serde = { version = "1", features = ["derive"] }
 serde_json = "1"
 thiserror = "1"
 
 # ── Crypto supply-chain lockdown (crypto-deps-lockdown, Wave W0, Phase 1) ────
 # All 7 crates are exact-pinned (=x.y.z) and optional = true.
 # They are gathered under the OFF-by-default `crypto` feature umbrella (D-7).
 # Pins + Cargo.lock are real and CI-enforced; no transitive compile cost today.
 # Version floors (hard constraints from stride-cve / RUSTSEC-2022-0093):
 #   ed25519-dalek >= 2, curve25519-dalek >= 4 (transitive), aes-gcm >= 0.10
 # ED25519_VERIFY_STRICT contract: any Ed25519 verify MUST use verify_strict —
