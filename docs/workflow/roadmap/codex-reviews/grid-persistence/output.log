    13	export type GridItemKind = GridItemEntity["kind"];
    14	
    15	/**
    16	 * App bundle suffix — overridable for test rigs. Anything ending with
    17	 * `.app` (case-insensitive) is treated as a macOS application bundle.
    18	 */
    19	const APP_BUNDLE_SUFFIX = ".app";
    20	
    21	const DEFAULT_ICONS: Record<GridItemKind, string> = {
    22	  file: "doc.text",
    23	  folder: "folder",
    24	  app: "app.dashed",
    25	  url: "globe",
    26	};
    27	
    28	export interface GridItemFactoryDeps {
    29	  /** Returns an ISO timestamp; defaults to `new Date().toISOString()`. */
    30	  nowIso?: () => string;
    31	  /** Returns a unique id; defaults to a `crypto.randomUUID`-backed shim. */
    32	  newId?: (kind: GridItemKind) => string;
    33	}
    34	
    35	function resolveDeps(deps: GridItemFactoryDeps = {}): Required<
    36	  Pick<GridItemFactoryDeps, "nowIso" | "newId">
    37	> {
    38	  return {
    39	    nowIso: deps.nowIso ?? (() => new Date().toISOString()),
    40	    newId:
    41	      deps.newId ??
    42	      ((kind: GridItemKind) => `${kind}_${randomSlug()}`),
    43	  };
    44	}
    45	
    46	function randomSlug(): string {
    47	  if (typeof crypto !== "undefined" && crypto.randomUUID) {
    48	    return crypto.randomUUID();
    49	  }
    50	  return Math.random().toString(16).slice(2, 12);
    51	}
    52	
    53	/** Heuristic kind inference from a filesystem path. */
    54	export function inferKindFromPath(path: string): GridItemKind {
    55	  if (path.toLowerCase().endsWith(APP_BUNDLE_SUFFIX)) return "app";
    56	  if (path.endsWith("/")) return "folder";
    57	  // The drop adapter labels folders explicitly; the bare path heuristic
    58	  // defaults the unknown case to "file" — most drag-ins are files.
    59	  return "file";
    60	}
    61	
    62	export interface CreateFileGridItemInput {
    63	  gridId: string;
    64	  filename: string;
    65	  filepath: string;
    66	  size?: number;
    67	  icon?: string;
    68	}
    69	
    70	export function createFileGridItem(
    71	  input: CreateFileGridItemInput,
    72	  deps: GridItemFactoryDeps = {},
    73	): GridItemEntity {
    74	  const { nowIso, newId } = resolveDeps(deps);
    75	  const timestamp = nowIso();
    76	  return {
    77	    id: newId("file"),
    78	    entityType: "organizer.item",
    79	    schemaVersion: 1,
    80	    createdAt: timestamp,
    81	    updatedAt: timestamp,
    82	    syncScope: "account-sync",
    83	    gridId: input.gridId,
    84	    filename: input.filename,
    85	    filepath: input.filepath,
    86	    kind: "file",
    87	    icon: input.icon ?? DEFAULT_ICONS.file,
    88	    size: input.size,
    89	  };
    90	}
    91	
    92	export interface CreateFolderGridItemInput {
    93	  gridId: string;
    94	  name: string;
    95	  filepath: string;
    96	  icon?: string;
    97	}
    98	
    99	export function createFolderGridItem(
   100	  input: CreateFolderGridItemInput,
   101	  deps: GridItemFactoryDeps = {},
   102	): GridItemEntity {
   103	  const { nowIso, newId } = resolveDeps(deps);
   104	  const timestamp = nowIso();
   105	  return {
   106	    id: newId("folder"),
   107	    entityType: "organizer.item",
   108	    schemaVersion: 1,
   109	    createdAt: timestamp,
   110	    updatedAt: timestamp,
   111	    syncScope: "account-sync",
   112	    gridId: input.gridId,
   113	    filename: input.name,
   114	    filepath: input.filepath,
   115	    kind: "folder",
   116	    icon: input.icon ?? DEFAULT_ICONS.folder,
   117	  };
   118	}
   119	
   120	export interface CreateAppGridItemInput {
   121	  gridId: string;
   122	  name: string;
   123	  filepath: string;
   124	  icon?: string;
   125	}
   126	
   127	export function createAppGridItem(
   128	  input: CreateAppGridItemInput,
   129	  deps: GridItemFactoryDeps = {},
   130	): GridItemEntity {
   131	  const { nowIso, newId } = resolveDeps(deps);
   132	  const timestamp = nowIso();
   133	  return {
   134	    id: newId("app"),
   135	    entityType: "organizer.item",
   136	    schemaVersion: 1,
   137	    createdAt: timestamp,
   138	    updatedAt: timestamp,
   139	    syncScope: "account-sync",
   140	    gridId: input.gridId,
   141	    filename: input.name,
   142	    filepath: input.filepath,
   143	    kind: "app",
   144	    icon: input.icon ?? DEFAULT_ICONS.app,
   145	  };
   146	}
   147	
   148	export interface CreateUrlGridItemInput {
   149	  gridId: string;
   150	  href: string;
   151	  title?: string;
   152	  description?: string;
   153	  favicon?: string;
   154	  icon?: string;
   155	}
   156	
   157	export class InvalidUrlError extends Error {
   158	  constructor(message: string) {
   159	    super(message);
   160	    this.name = "InvalidUrlError";
   161	  }
   162	}
   163	
   164	/**
   165	 * Build a URL item. Validates that `href` parses as a `URL` and that
   166	 * its protocol is `http(s):`, otherwise throws `InvalidUrlError`. Other
   167	 * protocols (file://, mailto:) are rejected because they require Finder
   168	 * collaboration paths that have their own factories.
   169	 */
   170	export function createUrlGridItem(
   171	  input: CreateUrlGridItemInput,
   172	  deps: GridItemFactoryDeps = {},
   173	): GridItemEntity {
   174	  let url: URL;
   175	  try {
   176	    url = new URL(input.href);
   177	  } catch {
   178	    throw new InvalidUrlError(
   179	      `URL parse failed for "${input.href}" — must be a fully qualified http(s) URL`,
   180	    );
   181	  }
   182	  if (url.protocol !== "http:" && url.protocol !== "https:") {
   183	    throw new InvalidUrlError(
   184	      `URL protocol "${url.protocol}" not allowed; expected http: or https:`,
   185	    );
   186	  }
   187	
   188	  const { nowIso, newId } = resolveDeps(deps);
   189	  const timestamp = nowIso();
   190	  return {
   191	    id: newId("url"),
   192	    entityType: "organizer.item",
   193	    schemaVersion: 1,
   194	    createdAt: timestamp,
   195	    updatedAt: timestamp,
   196	    syncScope: "account-sync",
   197	    gridId: input.gridId,
   198	    filename: input.title?.trim() || url.hostname,
   199	    kind: "url",
   200	    icon: input.icon ?? DEFAULT_ICONS.url,
   201	    url: {
   202	      href: url.toString(),
   203	      title: input.title?.trim() || undefined,
   204	      description: input.description?.trim() || undefined,
   205	      favicon: input.favicon,
   206	    },
   207	  };
   208	}
   209	
   210	/**
   211	 * Bulk factory for Finder-style drop adapters. Each path becomes a
   212	 * typed item; kind is inferred from `inferKindFromPath` unless the
   213	 * caller pins it explicitly via `kindOverride`.
   214	 */
   215	export interface FinderDropEntry {
   216	  filepath: string;
   217	  filename: string;
   218	  size?: number;
   219	  kindOverride?: GridItemKind;
   220	}
   221	
   222	export function createGridItemsFromFinderDrop(
   223	  gridId: string,
   224	  entries: FinderDropEntry[],
   225	  deps: GridItemFactoryDeps = {},
   226	): GridItemEntity[] {
   227	  return entries.map((entry) => {
   228	    const kind = entry.kindOverride ?? inferKindFromPath(entry.filepath);
   229	    switch (kind) {
   230	      case "app":
   231	        return createAppGridItem(
   232	          { gridId, name: entry.filename, filepath: entry.filepath },
   233	          deps,
   234	        );
   235	      case "folder":
   236	        return createFolderGridItem(
   237	          { gridId, name: entry.filename, filepath: entry.filepath },
   238	          deps,
   239	        );
   240	      case "url":
   241	        // Unusual — Finder drops are filesystem paths. If the caller
   242	        // pins `kindOverride = "url"` we treat the path as the href
   243	        // for parity with the pasteboard URL path.
   244	        return createUrlGridItem({ gridId, href: entry.filepath }, deps);
   245	      case "file":
   246	      default:
   247	        return createFileGridItem(
   248	          {
   249	            gridId,
   250	            filename: entry.filename,
   251	            filepath: entry.filepath,
   252	            size: entry.size,
   253	          },
   254	          deps,
   255	        );
   256	    }
   257	  });
   258	}

