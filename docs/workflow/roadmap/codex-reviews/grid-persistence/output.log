   140	        const [namespace, id, json, updatedAtMs] = params;
   141	        records.set(rowKey(asString(namespace), asString(id)), {
   142	          namespace: asString(namespace),
   143	          id: asString(id),
   144	          json: asString(json),
   145	          updatedAtMs: asNumber(updatedAtMs),
   146	        });
   147	        return;
   148	      }
   149	
   150	      if (normalized === normalizeSql(SQLITE_STATEMENTS.deleteRecord)) {
   151	        const [namespace, id] = params;
   152	        records.delete(rowKey(asString(namespace), asString(id)));
   153	        return;
   154	      }
   155	
   156	      throw new Error(`unsupported test SQL execute: ${normalized}`);
   157	    },
   158	
   159	    async query<T extends Record<string, unknown>>(
   160	      sql: string,
   161	      params: SqlParams = [],
   162	    ): Promise<T[]> {
   163	      const normalized = normalizeSql(sql);
   164	      txLog.push(normalized);
   165	
   166	      if (normalized === normalizeSql(SQLITE_STATEMENTS.selectRecord)) {
   167	        const [namespace, id] = params;
   168	        const row = records.get(rowKey(asString(namespace), asString(id)));
   169	        return (row ? [{ json: row.json }] : []) as unknown as T[];
   170	      }
   171	
   172	      if (normalized === normalizeSql(SQLITE_STATEMENTS.selectAll)) {
   173	        const [namespace] = params;
   174	        return [...records.values()]
   175	          .filter((row) => row.namespace === namespace)
   176	          .sort((a, b) => a.id.localeCompare(b.id))
   177	          .map((row) => ({ json: row.json })) as unknown as T[];
   178	      }
   179	
   180	      throw new Error(`unsupported test SQL query: ${normalized}`);
   181	    },
