   177	#[derive(Debug, Deserialize)]
   178	pub struct DbGetInput {
   179	    pub namespace: String,
   180	    pub id: String,
   181	}
   182	
   183	/// Fetch a single record's JSON payload. Returns `null` if absent.
   184	#[tauri::command]
   185	pub async fn db_get(
   186	    state: tauri::State<'_, DatabaseState>,
   187	    input: DbGetInput,
   188	) -> AppResult<Option<String>> {
   189	    validate_namespace(&input.namespace)?;
   190	    validate_id(&input.id)?;
   191	    state.with_conn(|conn| {
   192	        let row: Result<String, rusqlite::Error> = conn.query_row(
   193	            SELECT_RECORD_SQL,
   194	            params![input.namespace, input.id],
   195	            |row| row.get::<_, String>(0),
   196	        );
   197	        match row {
   198	            Ok(json) => Ok(Some(json)),
   199	            Err(rusqlite::Error::QueryReturnedNoRows) => Ok(None),
   200	            Err(err) => Err(AppError::DatabaseBackend(err.to_string())),
   201	        }
   202	    })
   203	}
   204	
   205	#[derive(Debug, Deserialize)]
   206	pub struct DbListInput {
   207	    pub namespace: String,
   208	}
   209	
   210	/// List all JSON payloads in a namespace, sorted by `id`.
   211	#[tauri::command]
   212	pub async fn db_list(
   213	    state: tauri::State<'_, DatabaseState>,
   214	    input: DbListInput,
   215	) -> AppResult<Vec<String>> {
   216	    validate_namespace(&input.namespace)?;
   217	    state.with_conn(|conn| {
   218	        let mut stmt = conn
   219	            .prepare(SELECT_ALL_SQL)
   220	            .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   221	        let rows = stmt
   222	            .query_map(params![input.namespace], |row| row.get::<_, String>(0))
   223	            .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   224	        let mut out = Vec::new();
   225	        for row in rows {
   226	            out.push(row.map_err(|err| AppError::DatabaseBackend(err.to_string()))?);
   227	        }
   228	        Ok(out)
   229	    })
   230	}
