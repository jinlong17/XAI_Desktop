   238	/// Delete a single record. Idempotent.
   239	#[tauri::command]
   240	pub async fn db_delete(
   241	    state: tauri::State<'_, DatabaseState>,
   242	    input: DbDeleteInput,
   243	) -> AppResult<()> {
   244	    validate_namespace(&input.namespace)?;
   245	    validate_id(&input.id)?;
   246	    state.with_conn(|conn| {
   247	        conn.execute(
