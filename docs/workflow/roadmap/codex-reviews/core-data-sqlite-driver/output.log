   249	            params![input.namespace, input.id],
   250	        )
   251	        .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   252	        Ok(())
   253	    })
   254	}
   255	
   256	fn validate_namespace(value: &str) -> AppResult<()> {
   257	    if value.is_empty() || value.len() > 128 {
   258	        return Err(AppError::DatabaseInvalidInput(format!(
   259	            "namespace must be 1..=128 chars (got {})",
   260	            value.len()
   261	        )));
   262	    }
   263	    if !value.bytes().all(|b| {
   264	        b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-' | b':')
   265	    }) {
   266	        return Err(AppError::DatabaseInvalidInput(
   267	            "namespace must match [A-Za-z0-9._:-]+".into(),
   268	        ));
   269	    }
   270	    Ok(())
   271	}
   272	
   273	fn validate_id(value: &str) -> AppResult<()> {
   274	    if value.is_empty() || value.len() > 256 {
   275	        return Err(AppError::DatabaseInvalidInput(format!(
   276	            "id must be 1..=256 chars (got {})",
   277	            value.len()
   278	        )));
   279	    }
   280	    Ok(())
   281	}
