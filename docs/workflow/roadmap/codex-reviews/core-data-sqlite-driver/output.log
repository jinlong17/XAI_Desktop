   113	fn resolve_db_path(app: &tauri::AppHandle) -> AppResult<PathBuf> {
   114	    let dir = app
   115	        .path()
   116	        .app_data_dir()
   117	        .map_err(|err| AppError::DatabaseBackend(format!("app_data_dir: {err}")))?;
   118	    Ok(dir.join(DB_FILE_NAME))
   119	}
