   144	#[derive(Debug, Serialize, Deserialize)]
   145	pub struct DbInitOutput {
   146	    pub namespace: String,
   147	    pub path: String,
   148	}
   149	
   150	/// Initialize the repo database. Creates the parent directory and the
   151	/// `core_data_records` table if missing. Idempotent.
   152	#[tauri::command]
   153	pub async fn db_init(
   154	    app: tauri::AppHandle,
   155	    window: tauri::WebviewWindow,
   156	    state: tauri::State<'_, DatabaseState>,
   157	    namespace: String,
   158	) -> AppResult<DbInitOutput> {
   159	    ensure_database_window_allowed(window.label())?;
   160	    validate_namespace(&namespace)?;
   161	    let path = resolve_db_path(&app)?;
   162	    state.open_at(&path)?;
   163	    Ok(DbInitOutput {
   164	        namespace,
   165	        path: path.to_string_lossy().into_owned(),
   166	    })
   167	}
   168	
   169	#[derive(Debug, Deserialize)]
   170	pub struct DbPutInput {
   171	    pub namespace: String,
   172	    pub id: String,
   173	    pub json: String,
   174	    #[serde(rename = "updatedAtMs")]
   175	    pub updated_at_ms: i64,
   176	}
   177	
   178	/// Upsert a single record. The `json` payload must be valid JSON; this is
   179	/// the caller's responsibility (the driver does not parse it).
   180	#[tauri::command]
   181	pub async fn db_put(
   182	    window: tauri::WebviewWindow,
   183	    state: tauri::State<'_, DatabaseState>,
   184	    input: DbPutInput,
   185	) -> AppResult<()> {
   186	    ensure_database_window_allowed(window.label())?;
   187	    validate_namespace(&input.namespace)?;
   188	    validate_id(&input.id)?;
   189	    state.with_conn(|conn| {
   190	        conn.execute(
   191	            UPSERT_RECORD_SQL,
   192	            params![
   193	                input.namespace,
   194	                input.id,
   195	                input.json,
   196	                input.updated_at_ms
   197	            ],
   198	        )
   199	        .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   200	        Ok(())
   201	    })
   202	}
   203	
   204	#[derive(Debug, Deserialize)]
   205	pub struct DbGetInput {
   206	    pub namespace: String,
   207	    pub id: String,
   208	}
   209	
   210	/// Fetch a single record's JSON payload. Returns `null` if absent.
   211	#[tauri::command]
   212	pub async fn db_get(
   213	    window: tauri::WebviewWindow,
   214	    state: tauri::State<'_, DatabaseState>,
   215	    input: DbGetInput,
   216	) -> AppResult<Option<String>> {
   217	    ensure_database_window_allowed(window.label())?;
   218	    validate_namespace(&input.namespace)?;
   219	    validate_id(&input.id)?;
   220	    state.with_conn(|conn| {
   221	        let row: Result<String, rusqlite::Error> = conn.query_row(
   222	            SELECT_RECORD_SQL,
   223	            params![input.namespace, input.id],
   224	            |row| row.get::<_, String>(0),
   225	        );
   226	        match row {
   227	            Ok(json) => Ok(Some(json)),
   228	            Err(rusqlite::Error::QueryReturnedNoRows) => Ok(None),
   229	            Err(err) => Err(AppError::DatabaseBackend(err.to_string())),
   230	        }
   231	    })
   232	}
   233	
   234	#[derive(Debug, Deserialize)]
   235	pub struct DbListInput {
   236	    pub namespace: String,
   237	}
   238	
   239	/// List all JSON payloads in a namespace, sorted by `id`.
   240	#[tauri::command]
   241	pub async fn db_list(
   242	    window: tauri::WebviewWindow,
   243	    state: tauri::State<'_, DatabaseState>,
   244	    input: DbListInput,
   245	) -> AppResult<Vec<String>> {
   246	    ensure_database_window_allowed(window.label())?;
   247	    validate_namespace(&input.namespace)?;
   248	    state.with_conn(|conn| {
   249	        let mut stmt = conn
   250	            .prepare(SELECT_ALL_SQL)
   251	            .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   252	        let rows = stmt
   253	            .query_map(params![input.namespace], |row| row.get::<_, String>(0))
   254	            .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   255	        let mut out = Vec::new();
   256	        for row in rows {
   257	            out.push(row.map_err(|err| AppError::DatabaseBackend(err.to_string()))?);
   258	        }
   259	        Ok(out)
   260	    })
   261	}
   262	
   263	#[derive(Debug, Deserialize)]
   264	pub struct DbDeleteInput {
   265	    pub namespace: String,
   266	    pub id: String,
   267	}
   268	
   269	/// Delete a single record. Idempotent.
   270	#[tauri::command]
   271	pub async fn db_delete(
   272	    window: tauri::WebviewWindow,
   273	    state: tauri::State<'_, DatabaseState>,
   274	    input: DbDeleteInput,
   275	) -> AppResult<()> {
   276	    ensure_database_window_allowed(window.label())?;
   277	    validate_namespace(&input.namespace)?;
   278	    validate_id(&input.id)?;
   279	    state.with_conn(|conn| {
   280	        conn.execute(
   281	            DELETE_RECORD_SQL,
   282	            params![input.namespace, input.id],
   283	        )
   284	        .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   285	        Ok(())
   286	    })
   287	}
   288	
   289	fn validate_namespace(value: &str) -> AppResult<()> {
   290	    if value.is_empty() || value.len() > 128 {
   291	        return Err(AppError::DatabaseInvalidInput(format!(
   292	            "namespace must be 1..=128 chars (got {})",
   293	            value.len()
   294	        )));
   295	    }
   296	    if !value.bytes().all(|b| {
   297	        b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-' | b':')
   298	    }) {
   299	        return Err(AppError::DatabaseInvalidInput(
   300	            "namespace must match [A-Za-z0-9._:-]+".into(),
   301	        ));
   302	    }
   303	    Ok(())
   304	}
   305	
   306	fn validate_id(value: &str) -> AppResult<()> {
   307	    if value.is_empty() || value.len() > 256 {
   308	        return Err(AppError::DatabaseInvalidInput(format!(
   309	            "id must be 1..=256 chars (got {})",
   310	            value.len()
   311	        )));
   312	    }
   313	    Ok(())
   314	}
