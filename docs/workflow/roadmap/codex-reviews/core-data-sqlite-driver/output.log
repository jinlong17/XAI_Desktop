    61	/// Tauri-managed state holding the lazily-opened SQLite connection.
    62	#[derive(Default)]
    63	pub struct DatabaseState {
    64	    inner: Mutex<Option<DatabaseInner>>,
    65	}
    66	
    67	struct DatabaseInner {
    68	    conn: Connection,
    69	}
    70	
    71	impl DatabaseState {
    72	    fn open_at(&self, path: &PathBuf) -> AppResult<()> {
    73	        let mut guard = self.inner.lock().map_err(|err| {
    74	            AppError::DatabaseBackend(format!("state lock poisoned: {err}"))
    75	        })?;
    76	
    77	        if guard.is_some() {
    78	            return Ok(());
    79	        }
    80	
    81	        if let Some(parent) = path.parent() {
    82	            std::fs::create_dir_all(parent)
    83	                .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
    84	        }
    85	
    86	        let conn = Connection::open_with_flags(
    87	            path,
    88	            OpenFlags::SQLITE_OPEN_READ_WRITE | OpenFlags::SQLITE_OPEN_CREATE,
    89	        )
    90	        .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
    91	
    92	        conn.execute_batch(CREATE_RECORDS_SQL)
    93	            .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
    94	
    95	        *guard = Some(DatabaseInner { conn });
    96	        Ok(())
    97	    }
    98	
    99	    fn with_conn<F, T>(&self, f: F) -> AppResult<T>
   100	    where
   101	        F: FnOnce(&Connection) -> AppResult<T>,
   102	    {
   103	        let guard = self.inner.lock().map_err(|err| {
   104	            AppError::DatabaseBackend(format!("state lock poisoned: {err}"))
   105	        })?;
   106	        let inner = guard
   107	            .as_ref()
   108	            .ok_or(AppError::DatabaseNotInitialized)?;
   109	        f(&inner.conn)
   110	    }
   111	}
