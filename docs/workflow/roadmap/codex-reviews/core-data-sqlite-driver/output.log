     9	
    10	function makeRecord(id: string, overrides: Partial<TodoRecord> = {}): TodoRecord {
    11	  return {
    12	    id,
    13	    entityType: "productivity.todo",
    14	    schemaVersion: 1,
    15	    createdAt: "2026-05-20T00:00:00.000Z",
    16	    updatedAt: "2026-05-20T00:00:00.000Z",
    17	    syncScope: "account-sync",
    18	    title: id,
    19	    ...overrides,
    20	  };
    21	}
    22	
    23	interface CallLog {
    24	  cmd: string;
    25	  args?: Record<string, unknown>;
    26	}
    27	
    28	function fakeStorage() {
    29	  const records = new Map<string, string>();
    30	  const calls: CallLog[] = [];
    31	
    32	  function key(namespace: string, id: string) {
    33	    return `${namespace}␀${id}`;
    34	  }
    35	
    36	  async function invoke<T>(
    37	    cmd: string,
    38	    args?: Record<string, unknown>,
    39	  ): Promise<T> {
    40	    calls.push({ cmd, args });
    41	    if (cmd === "db_init") {
    42	      const ns = args!.namespace as string;
    43	      return { namespace: ns, path: `/tmp/${ns}.db` } as unknown as T;
    44	    }
    45	    if (cmd === "db_put") {
    46	      const input = args!.input as {
    47	        namespace: string;
    48	        id: string;
    49	        json: string;
    50	      };
    51	      records.set(key(input.namespace, input.id), input.json);
    52	      return undefined as unknown as T;
    53	    }
    54	    if (cmd === "db_get") {
    55	      const input = args!.input as { namespace: string; id: string };
    56	      const raw = records.get(key(input.namespace, input.id));
    57	      return (raw ?? null) as unknown as T;
    58	    }
    59	    if (cmd === "db_list") {
    60	      const input = args!.input as { namespace: string };
    61	      const prefix = `${input.namespace}␀`;
    62	      const out: string[] = [];
    63	      for (const [k, v] of records) {
    64	        if (k.startsWith(prefix)) out.push(v);
    65	      }
    66	      out.sort();
    67	      return out as unknown as T;
    68	    }
    69	    if (cmd === "db_delete") {
    70	      const input = args!.input as { namespace: string; id: string };
    71	      records.delete(key(input.namespace, input.id));
    72	      return undefined as unknown as T;
    73	    }
    74	    throw new Error(`unknown cmd: ${cmd}`);
    75	  }
    76	
    77	  return { invoke, calls, records };
    78	}
