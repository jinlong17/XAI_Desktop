     1	//! Tauri IPC commands for the Repository v0 SQLite driver.
     2	//!
     3	//! G2.2 PoC scope: expose CRUD that matches the TS `SqliteDriver`
     4	//! interface in `@repo/core-data/sqlite.ts`. One bundled-sqlcipher
     5	//! Connection is owned by Tauri-managed state; the on-disk file lives
     6	//! under the app data directory (`xai-repo-v0.db`).
     7	//!
     8	//! Encryption is intentionally **not** wired in this PoC — the SQLCipher
     9	//! PRAGMA path is exercised separately by `crypto::sqlcipher` unit tests.
    10	//! Once G2.4 publishes a stable opaque KEK handle, `db_open` will gain
    11	//! a `kek_handle` parameter and apply `PRAGMA key`. The wire format is
    12	//! designed so the JS side does not need to change when that happens.
    13	//!
    14	//! Wire commands (all gated to `main`,`control`,`grid_*`,`account` via
    15	//! `capabilities/default.json`):
    16	//!
    17	//! - `db_init { namespace }` → idempotent. Creates the shared table
    18	//!   `core_data_records (namespace, id, json, updated_at_ms)`.
    19	//! - `db_put { namespace, id, json, updatedAtMs }` → upsert.
    20	//! - `db_get { namespace, id }` → returns `json | null`.
    21	//! - `db_list { namespace }` → returns rows sorted by `id`.
    22	//! - `db_delete { namespace, id }` → idempotent.
    23	//!
    24	//! Errors map to the `E13xx` family in `error.rs`.
    25	
    26	#![cfg(feature = "crypto")]
    27	
    28	use std::path::PathBuf;
    29	use std::sync::Mutex;
    30	
    31	use rusqlite::{params, Connection, OpenFlags};
    32	use serde::{Deserialize, Serialize};
    33	use tauri::Manager;
    34	
    35	use crate::error::{AppError, AppResult};
    36	
    37	const DB_FILE_NAME: &str = "xai-repo-v0.db";
    38	
    39	/// Windows allowed to invoke `db_*` commands. Mirrors
    40	/// `capabilities/plugin-data-database.json`. `grid_*` matches the
    41	/// per-Grid native windows. Widget / pet / ai-cube windows are
    42	/// explicitly excluded — they must not persist Repository v0 data
    43	/// directly; they go through the owning plugin instead.
    44	const DATABASE_ALLOWED_WINDOWS: &[&str] = &["main", "control", "account", "console"];
    45	
    46	fn is_database_window_allowed(label: &str) -> bool {
    47	    if DATABASE_ALLOWED_WINDOWS.contains(&label) {
    48	        return true;
    49	    }
    50	    label.starts_with("grid_")
    51	}
    52	
    53	fn ensure_database_window_allowed(label: &str) -> AppResult<()> {
    54	    if is_database_window_allowed(label) {
    55	        return Ok(());
    56	    }
    57	    Err(AppError::SyncCapabilityDenied(format!(
    58	        "window `{label}` is not allowed to invoke db_* commands"
    59	    )))
    60	}
    61	
    62	const CREATE_RECORDS_SQL: &str = "CREATE TABLE IF NOT EXISTS core_data_records (\
    63	    namespace TEXT NOT NULL, \
    64	    id TEXT NOT NULL, \
    65	    json TEXT NOT NULL, \
    66	    updated_at_ms INTEGER NOT NULL, \
    67	    PRIMARY KEY (namespace, id))";
    68	
    69	const UPSERT_RECORD_SQL: &str = "INSERT INTO core_data_records (namespace, id, json, updated_at_ms) \
    70	    VALUES (?1, ?2, ?3, ?4) \
    71	    ON CONFLICT(namespace, id) DO UPDATE SET \
    72	    json = excluded.json, \
    73	    updated_at_ms = excluded.updated_at_ms";
    74	
    75	const SELECT_RECORD_SQL: &str =
    76	    "SELECT json FROM core_data_records WHERE namespace = ?1 AND id = ?2";
    77	
    78	const SELECT_ALL_SQL: &str =
    79	    "SELECT json FROM core_data_records WHERE namespace = ?1 ORDER BY id ASC";
    80	
    81	const DELETE_RECORD_SQL: &str =
    82	    "DELETE FROM core_data_records WHERE namespace = ?1 AND id = ?2";
    83	
    84	/// Tauri-managed state holding the lazily-opened SQLite connection.
    85	#[derive(Default)]
    86	pub struct DatabaseState {
    87	    inner: Mutex<Option<DatabaseInner>>,
    88	}
    89	
    90	struct DatabaseInner {
    91	    conn: Connection,
    92	}
    93	
    94	impl DatabaseState {
    95	    fn open_at(&self, path: &PathBuf) -> AppResult<()> {
    96	        let mut guard = self.inner.lock().map_err(|err| {
    97	            AppError::DatabaseBackend(format!("state lock poisoned: {err}"))
    98	        })?;
    99	
   100	        if guard.is_some() {
   101	            return Ok(());
   102	        }
   103	
   104	        if let Some(parent) = path.parent() {
   105	            std::fs::create_dir_all(parent)
   106	                .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   107	        }
   108	
   109	        let conn = Connection::open_with_flags(
   110	            path,
   111	            OpenFlags::SQLITE_OPEN_READ_WRITE | OpenFlags::SQLITE_OPEN_CREATE,
   112	        )
   113	        .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   114	
   115	        conn.execute_batch(CREATE_RECORDS_SQL)
   116	            .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   117	
   118	        *guard = Some(DatabaseInner { conn });
   119	        Ok(())
   120	    }
   121	
   122	    fn with_conn<F, T>(&self, f: F) -> AppResult<T>
   123	    where
   124	        F: FnOnce(&Connection) -> AppResult<T>,
   125	    {
   126	        let guard = self.inner.lock().map_err(|err| {
   127	            AppError::DatabaseBackend(format!("state lock poisoned: {err}"))
   128	        })?;
   129	        let inner = guard
   130	            .as_ref()
   131	            .ok_or(AppError::DatabaseNotInitialized)?;
   132	        f(&inner.conn)
   133	    }
   134	}
   135	
   136	fn resolve_db_path(app: &tauri::AppHandle) -> AppResult<PathBuf> {
   137	    let dir = app
   138	        .path()
   139	        .app_data_dir()
   140	        .map_err(|err| AppError::DatabaseBackend(format!("app_data_dir: {err}")))?;
   141	    Ok(dir.join(DB_FILE_NAME))
   142	}
