    47	  namespace: string,
    48	): Promise<DbInitOutput> {
    49	  return invoke<DbInitOutput>("db_init", { namespace });
    50	}
    51	
    52	/**
    53	 * Create a Repository v0-compatible API bound to the Tauri SQLite
    54	 * driver for a single namespace.
    55	 *
    56	 * The repo lazily calls `db_init` on its first operation. Subsequent
    57	 * operations reuse the open connection.
    58	 */
    59	export function createTauriRepo<T extends RepoRecord>(
    60	  invoke: InvokeFn,
    61	  options: CreateTauriRepoOptions,
    62	): Repo<T> {
    63	  const { namespace } = options;
    64	  const nowMs = options.nowMs ?? Date.now;
    65	  let initialized: Promise<void> | undefined;
    66	
    67	  async function ensureInit(): Promise<void> {
    68	    if (!initialized) {
    69	      initialized = invoke<DbInitOutput>("db_init", { namespace }).then(
    70	        () => undefined,
    71	      );
    72	    }
    73	    await initialized;
    74	  }
    75	
    76	  async function listAll(): Promise<T[]> {
    77	    await ensureInit();
    78	    const rows = await invoke<string[]>("db_list", {
    79	      input: { namespace },
    80	    });
    81	    return rows.map((json) => {
    82	      const parsed = JSON.parse(json) as T;
    83	      assertRepoRecord(parsed);
    84	      return parsed;
    85	    });
    86	  }
    87	
    88	  const operations: RepoTransaction<T> = {
    89	    async get(id: string): Promise<T | undefined> {
    90	      await ensureInit();
    91	      const raw = await invoke<string | null>("db_get", {
    92	        input: { namespace, id },
    93	      });
    94	      if (raw == null) return undefined;
    95	      const parsed = JSON.parse(raw) as T;
    96	      assertRepoRecord(parsed);
    97	      return parsed;
    98	    },
    99	
   100	    async put(record: T): Promise<void> {
   101	      assertRepoRecord(record);
   102	      await ensureInit();
   103	      await invoke<void>("db_put", {
   104	        input: {
   105	          namespace,
   106	          id: record.id,
   107	          json: JSON.stringify(record),
   108	          updatedAtMs: nowMs(),
   109	        },
   110	      });
   111	    },
   112	
   113	    async delete(id: string): Promise<void> {
   114	      await ensureInit();
   115	      await invoke<void>("db_delete", {
   116	        input: { namespace, id },
   117	      });
   118	    },
   119	
   120	    async list(query?: RepoListQuery<T>): Promise<T[]> {
   121	      return applyRepoListQuery(await listAll(), query);
   122	    },
   123	
   124	    async listByIndex<K extends Extract<keyof T, string>>(
   125	      field: K,
   126	      value: T[K],
   127	      query?: RepoListQuery<T>,
   128	    ): Promise<T[]> {
   129	      return applyRepoIndexQuery(await listAll(), field, value, query);
   130	    },
   131	
   132	    async metadata(): Promise<RepoMetadata> {
   133	      const records = await listAll();
   134	      return {
   135	        driver: "tauri-sqlite",
   136	        namespace,
   137	        schemaVersion: options.schemaVersion ?? 1,
   138	        migrationVersion: 0,
   139	        recordCount: records.length,
   140	        migrations: [],
   141	      };
   142	    },
   143	  };
   144	
   145	  return {
   146	    ...operations,
   147	
   148	    /**
   149	     * NOTE: G2.2 PoC scope. Cross-command atomicity will be added when
   150	     * the Tauri command surface gains `db_transaction_begin` and
   151	     * `db_transaction_commit`. The TS surface keeps the contract shape
   152	     * so callers do not need to rewrite when that lands.
   153	     */
   154	    async transaction<R>(
   155	      fn: (tx: RepoTransaction<T>) => Promise<R>,
   156	    ): Promise<R> {
   157	      await ensureInit();
   158	      return fn(operations);
   159	    },
   160	
   161	    async migrate(): Promise<never> {
   162	      throw new Error(
   163	        "E1300: tauri-sqlite migrate() not yet wired — use createSqliteRepo in tests or wait for G2.2 follow-up",
   164	      );
   165	    },
   166	  };
   167	}

