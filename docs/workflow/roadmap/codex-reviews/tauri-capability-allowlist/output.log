     1	//! Tauri IPC commands for the macOS Keychain bridge.
     2	//!
     3	//! These three commands are the only public surface for Keychain access.
     4	//! They are registered in `lib.rs` `invoke_handler!` and scoped to the
     5	//! `plugin-account` window via the `plugin-account` capability file.
     6	//!
     7	//! All commands return `AppResult<T>` — on error the JS caller receives a
     8	//! JSON-serialised `AppError` with a JS-parseable `E11xx:` prefix.
     9	
    10	use crate::error::AppResult;
    11	use crate::platform;
    12	
    13	/// Store an opaque byte blob under `key` in the macOS Keychain.
    14	///
    15	/// Idempotent upsert: repeated calls with the same key update the stored bytes.
    16	/// Returns `E1100` (KeychainLocked) if the device is locked, `E1103` on other
    17	/// backend errors, `E1104` on non-macOS targets.
    18	#[tauri::command]
    19	pub async fn secret_set(key: String, value: Vec<u8>) -> AppResult<()> {
    20	    platform::macos::keychain::secret_set(&key, &value)
    21	}
    22	
    23	/// Retrieve the byte blob stored under `key` from the macOS Keychain.
    24	///
    25	/// Returns `E1101` (KeychainItemNotFound) if the key is absent,
    26	/// `E1100` (KeychainLocked) if the device is locked, `E1104` on non-macOS.
    27	#[tauri::command]
    28	pub async fn secret_get(key: String) -> AppResult<Vec<u8>> {
    29	    platform::macos::keychain::secret_get(&key)
    30	}
    31	
    32	/// Delete the keychain item for `key`.
    33	///
    34	/// Idempotent: if the key does not exist, returns success.
    35	/// Returns `E1100` (KeychainLocked) if the device is locked, `E1104` on non-macOS.
    36	#[tauri::command]
    37	pub async fn secret_del(key: String) -> AppResult<()> {
    38	    platform::macos::keychain::secret_del(&key)
    39	}

