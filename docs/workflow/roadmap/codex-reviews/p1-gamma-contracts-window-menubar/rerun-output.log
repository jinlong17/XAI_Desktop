    94	export async function migrateOrganizerLayoutToRepos(
    95	  options: OrganizerLayoutMigrationOptions,
    96	): Promise<OrganizerLayoutMigrationResult> {
    97	  const legacyKey = options.legacyKey ?? LEGACY_LAYOUT_STORAGE_KEY;
    98	  const raw = options.storage.getItem(legacyKey);
    99	  if (raw === null) {
   100	    return emptyResult();
   101	  }
   102	
   103	  let layout: LegacyOrganizerLayout;
   104	  try {
   105	    layout = JSON.parse(raw) as LegacyOrganizerLayout;
   106	  } catch {
   107	    return { ...emptyResult(), scanned: true };
   108	  }
   109	
   110	  if (
   111	    !layout ||
   112	    !Array.isArray(layout.grids) ||
   113	    !Array.isArray(layout.items)
   114	  ) {
   115	    return { ...emptyResult(), scanned: true };
   116	  }
   117	
   118	  const nowIso = options.nowIso ?? (() => new Date().toISOString());
   119	  const timestamp = nowIso();
   120	
   121	  let gridsMigrated = 0;
   122	  let itemsMigrated = 0;
   123	  let unchanged = 0;
   124	  let skipped = 0;
   125	
   126	  for (const legacyGrid of layout.grids) {
   127	    if (!legacyGrid || typeof legacyGrid.id !== "string") continue;
   128	    const record = toGridEntity(legacyGrid, timestamp);
   129	
   130	    // C2 — unchanged-skip: avoid re-stamping updatedAt on a no-op rerun.
   131	    const existing = await options.gridRepo.get(record.id);
   132	    if (existing && isGridRecordEqual(existing, record)) {
   133	      unchanged += 1;
   134	      continue;
   135	    }
   136	
   137	    assertRepoRecord(record);
   138	    await options.gridRepo.put(record);
   139	    gridsMigrated += 1;
   140	  }
   141	
   142	  for (const legacyItem of layout.items) {
   143	    if (!legacyItem || typeof legacyItem.id !== "string") continue;
   144	    const gridId = findOwningGridId(legacyItem.id, layout.grids);
   145	    if (!gridId) continue;
   146	    const record = toGridItemEntity(legacyItem, gridId, timestamp);
   147	
   148	    // A3 — positive validation rejected this legacy item.
   149	    if (!record) {
   150	      skipped += 1;
   151	      continue;
   152	    }
   153	
   154	    // C2 — unchanged-skip (same rationale as the grid loop).
   155	    const existing = await options.itemRepo.get(record.id);
   156	    if (existing && isItemRecordEqual(existing, record)) {
   157	      unchanged += 1;
   158	      continue;
   159	    }
   160	
   161	    assertRepoRecord(record);
   162	    await options.itemRepo.put(record);
   163	    itemsMigrated += 1;
   164	  }
   165	
   166	  let removedLegacy = false;
   167	  if (options.removeLegacy) {
   168	    options.storage.removeItem(legacyKey);
   169	    removedLegacy = true;
   170	  }
   171	
   172	  return {
   173	    scanned: true,
   174	    parsed: true,
   175	    gridsMigrated,
   176	    itemsMigrated,
   177	    unchanged,
   178	    skipped,
   179	    removedLegacy,
   180	  };
   181	}
