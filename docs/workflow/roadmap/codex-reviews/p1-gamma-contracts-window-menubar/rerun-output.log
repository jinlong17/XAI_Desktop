   174	/// Update an existing grid window's position and size
   175	#[tauri::command]
   176	pub async fn update_grid_window(
   177	    window: tauri::WebviewWindow,
   178	    app: AppHandle,
   179	    #[allow(non_snake_case)]
   180	    gridId: String,
   181	    rect: GridWindowRect,
   182	) -> Result<GridWindowSnapshot, CommandError> {
   183	    ensure_window_command_allowed(window.label())?;
   184	    update_grid_window_internal(app, gridId, rect).await
   185	}
   186	
   187	/// Internal update path used by both `update_grid_window` (with origin
   188	/// check) and `create_grid_window` (which has already enforced its own
   189	/// origin check before falling back to update).
   190	async fn update_grid_window_internal(
   191	    app: AppHandle,
   192	    grid_id: String,
   193	    rect: GridWindowRect,
   194	) -> Result<GridWindowSnapshot, CommandError> {
   195	    validate_grid_id(&grid_id)?;
   196	
   197	    let label = grid_label(&grid_id);
   198	
   199	    if let Some(window) = app.get_webview_window(&label) {
   200	        window
   201	            .set_position(tauri::Position::Logical(tauri::LogicalPosition {
   202	                x: rect.x,
   203	                y: rect.y,
   204	            }))
   205	            .map_err(|e| native_error(format!("Failed to set position: {}", e)))?;
   206	
   207	        window
   208	            .set_size(tauri::Size::Logical(tauri::LogicalSize {
   209	                width: rect.width,
   210	                height: rect.height,
   211	            }))
   212	            .map_err(|e| native_error(format!("Failed to set size: {}", e)))?;
   213	
   214	        // Update stored state
   215	        if let Some(state) = app.try_state::<GridWindowsState>() {
   216	            let mut windows = state.windows.lock().map_err(state_error)?;
   217	            windows.insert(grid_id.clone(), rect.clone());
   218	        }
   219	
   220	        println!("📐 Updated grid window: {} to ({}, {}) size {}x{}",
   221	                 label, rect.x, rect.y, rect.width, rect.height);
   222	        Ok(window_snapshot(&app, &grid_id, rect))
   223	    } else {
   224	        Err(command_error(
   225	            "WINDOW_NOT_FOUND",
   226	            format!("Window {} not found", label),
   227	            true,
   228	        ))
   229	    }
   230	}
