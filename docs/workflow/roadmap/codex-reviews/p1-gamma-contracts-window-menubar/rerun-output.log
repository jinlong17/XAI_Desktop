    79	fn window_snapshot(
    80	    app: &AppHandle,
    81	    grid_id: &str,
    82	    rect: GridWindowRect,
    83	) -> GridWindowSnapshot {
    84	    let label = grid_label(grid_id);
    85	    let visible = app
    86	        .get_webview_window(&label)
    87	        .and_then(|window| window.is_visible().ok())
    88	        .unwrap_or(false);
    89	
    90	    GridWindowSnapshot {
    91	        grid_id: grid_id.to_string(),
    92	        label,
    93	        rect,
    94	        visible,
    95	    }
    96	}
