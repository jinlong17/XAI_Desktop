   106	/// Create a new grid window at the specified position
   107	#[tauri::command]
   108	pub async fn create_grid_window(
   109	    window: tauri::WebviewWindow,
   110	    app: AppHandle,
   111	    #[allow(non_snake_case)]
   112	    gridId: String,
   113	    rect: GridWindowRect,
   114	) -> Result<GridWindowSnapshot, CommandError> {
   115	    ensure_window_command_allowed(window.label())?;
   116	    validate_grid_id(&gridId)?;
   117	
   118	    println!("🪟 Creating grid window: {} at ({}, {}) size {}x{}",
   119	             gridId, rect.x, rect.y, rect.width, rect.height);
   120	
   121	    let label = grid_label(&gridId);
   122	    let url = format!("/#/grid?id={}", gridId);
   123	
   124	    // Check if window already exists
   125	    if app.get_webview_window(&label).is_some() {
   126	        println!("⚠️ Window {} already exists, updating instead", label);
   127	        // Internal call after the caller's window-origin check already
   128	        // passed — bypass the public allow-list by going through
   129	        // `update_grid_window_internal`.
   130	        return update_grid_window_internal(app, gridId, rect).await;
   131	    }
   132	
   133	    // Create the window with grid-specific settings.
   134	    // `transparent(true)` is private-API gated on macOS, so the MAS dry-run
   135	    // feature intentionally omits it and relies on the native fallback styling.
   136	    let builder = WebviewWindowBuilder::new(&app, &label, WebviewUrl::App(url.into()))
   137	        .title("")
   138	        .inner_size(rect.width, rect.height)
   139	        .position(rect.x, rect.y);
   140	
   141	    #[cfg(not(feature = "mas-sandbox"))]
   142	    let builder = builder.transparent(true);
   143	
   144	    let window = builder
   145	        .decorations(false)
   146	        .shadow(false)
   147	        .skip_taskbar(true)
   148	        .resizable(false)
   149	        .visible(true)
   150	        .always_on_top(false)
   151	        .build()
   152	        .map_err(|e| native_error(format!("Failed to create window: {}", e)))?;
   153	
   154	    // Configure macOS-specific window settings
   155	    #[cfg(target_os = "macos")]
   156	    {
   157	        let window_clone = window.clone();
   158	        let _ = window.run_on_main_thread(move || {
   159	            platform::macos::configure_grid_window(&window_clone);
   160	        });
   161	    }
   162	
   163	    // Store window state
   164	    if let Some(state) = app.try_state::<GridWindowsState>() {
   165	        let mut windows = state.windows.lock().map_err(state_error)?;
   166	        windows.insert(gridId.clone(), rect.clone());
   167	    }
   168	
   169	    println!("✅ Grid window created successfully: {} at ({}, {}) size {}x{}",
   170	             label, rect.x, rect.y, rect.width, rect.height);
   171	    Ok(window_snapshot(&app, &gridId, rect))
   172	}
