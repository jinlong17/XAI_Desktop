   264	/// List known grid windows and their latest rect snapshots.
   265	#[tauri::command]
   266	pub async fn list_grid_windows(
   267	    window: tauri::WebviewWindow,
   268	    app: AppHandle,
   269	) -> Result<Vec<GridWindowSnapshot>, CommandError> {
   270	    ensure_window_command_allowed(window.label())?;
   271	    let Some(state) = app.try_state::<GridWindowsState>() else {
   272	        return Ok(Vec::new());
   273	    };
   274	
   275	    let windows = state.windows.lock().map_err(state_error)?;
   276	    let mut snapshots = windows
   277	        .iter()
   278	        .map(|(grid_id, rect)| window_snapshot(&app, grid_id, rect.clone()))
   279	        .collect::<Vec<_>>();
   280	    snapshots.sort_by(|a, b| a.grid_id.cmp(&b.grid_id));
   281	    Ok(snapshots)
   282	}
