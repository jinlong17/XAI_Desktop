   232	/// Close and destroy a grid window
   233	#[tauri::command]
   234	pub async fn close_grid_window(
   235	    window: tauri::WebviewWindow,
   236	    app: AppHandle,
   237	    #[allow(non_snake_case)]
   238	    gridId: String,
   239	) -> Result<(), CommandError> {
   240	    ensure_window_command_allowed(window.label())?;
   241	    validate_grid_id(&gridId)?;
   242	
   243	    let label = grid_label(&gridId);
   244	
   245	    if let Some(window) = app.get_webview_window(&label) {
   246	        window
   247	            .close()
   248	            .map_err(|e| native_error(format!("Failed to close window: {}", e)))?;
   249	
   250	        // Remove from stored state
   251	        if let Some(state) = app.try_state::<GridWindowsState>() {
   252	            let mut windows = state.windows.lock().map_err(state_error)?;
   253	            windows.remove(&gridId);
   254	        }
   255	
   256	        println!("🗑️ Closed grid window: {}", label);
   257	        Ok(())
   258	    } else {
   259	        // Window doesn't exist, that's fine
   260	        Ok(())
   261	    }
   262	}
