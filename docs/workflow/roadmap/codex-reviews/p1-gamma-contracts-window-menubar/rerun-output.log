    19	/// can request lifecycle changes for themselves via cross-window events
    20	/// routed through `control`, but they cannot directly spawn / close
    21	/// other grid windows.
    22	pub(crate) const WINDOW_ALLOWED_WINDOWS: &[&str] = &["main", "control"];
    23	
    24	fn is_window_command_allowed(label: &str) -> bool {
    25	    WINDOW_ALLOWED_WINDOWS.contains(&label)
    26	}
    27	
    28	fn ensure_window_command_allowed(label: &str) -> Result<(), CommandError> {
    29	    if is_window_command_allowed(label) {
    30	        Ok(())
    31	    } else {
    32	        Err(command_error(
    33	            "WINDOW_CAPABILITY_DENIED",
    34	            format!(
    35	                "window `{label}` is not allowed to invoke window lifecycle commands"
    36	            ),
    37	            false,
    38	        ))
    39	    }
    40	}
    41	
    42	fn grid_label(grid_id: &str) -> String {
    43	    format!("grid_{}", grid_id)
    44	}
    45	
    46	fn is_valid_grid_id(grid_id: &str) -> bool {
    47	    !grid_id.is_empty()
    48	        && grid_id.len() <= 128
    49	        && grid_id
    50	            .chars()
    51	            .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_')
    52	}
    53	
    54	fn command_error(
    55	    code: impl Into<String>,
    56	    message: impl Into<String>,
    57	    recoverable: bool,
    58	) -> CommandError {
    59	    CommandError {
    60	        code: code.into(),
    61	        message: message.into(),
    62	        recoverable,
    63	        details: None,
    64	    }
    65	}
    66	
    67	fn validate_grid_id(grid_id: &str) -> Result<(), CommandError> {
    68	    if is_valid_grid_id(grid_id) {
    69	        Ok(())
    70	    } else {
    71	        Err(command_error(
    72	            "INVALID_GRID_ID",
    73	            "gridId must be non-empty and contain only ASCII letters, numbers, '-' or '_'",
    74	            true,
    75	        ))
    76	    }
    77	}
