   284	/// Focus an existing grid window.
   285	#[tauri::command]
   286	pub async fn focus_grid_window(
   287	    window: tauri::WebviewWindow,
   288	    app: AppHandle,
   289	    #[allow(non_snake_case)]
   290	    gridId: String,
   291	) -> Result<GridWindowSnapshot, CommandError> {
   292	    ensure_window_command_allowed(window.label())?;
   293	    validate_grid_id(&gridId)?;
   294	
   295	    let label = grid_label(&gridId);
   296	    let Some(window) = app.get_webview_window(&label) else {
   297	        return Err(command_error(
   298	            "WINDOW_NOT_FOUND",
   299	            format!("Window {} not found", label),
   300	            true,
   301	        ));
   302	    };
   303	
   304	    window
   305	        .set_focus()
   306	        .map_err(|e| native_error(format!("Failed to focus window: {}", e)))?;
   307	
   308	    let rect = if let Some(state) = app.try_state::<GridWindowsState>() {
   309	        let windows = state.windows.lock().map_err(state_error)?;
   310	        windows.get(&gridId).cloned().unwrap_or(GridWindowRect {
   311	            x: 0.0,
   312	            y: 0.0,
   313	            width: 0.0,
   314	            height: 0.0,
   315	        })
   316	    } else {
   317	        GridWindowRect {
   318	            x: 0.0,
   319	            y: 0.0,
   320	            width: 0.0,
   321	            height: 0.0,
   322	        }
   323	    };
   324	
   325	    Ok(window_snapshot(&app, &gridId, rect))
   326	}
