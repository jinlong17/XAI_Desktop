   164	        for x in 0..ICON_SIZE {
   165	            let dx = x as f32 - center;
   166	            let dy = y as f32 - center;
   167	            let distance = (dx * dx + dy * dy).sqrt();
   168	            if distance <= radius {
   169	                set_pixel(&mut rgba, x, y, primary);
   170	            }
   171	            if let Some(color) = accent {
   172	                let adx = x as f32 - (center + 2.5);
   173	                let ady = y as f32 - (center - 2.5);
   174	                if (adx * adx + ady * ady).sqrt() <= accent_radius {
   175	                    set_pixel(&mut rgba, x, y, color);
   176	                }
   177	            }
   178	        }
   179	    }
   180	
   181	    rgba
   182	}
   183	
   184	fn spinner_icon(frame: u8, primary: [u8; 4]) -> Vec<u8> {
   185	    let mut rgba = vec![0; (ICON_SIZE * ICON_SIZE * 4) as usize];
   186	    let center = (ICON_SIZE as f32 - 1.0) / 2.0;
   187	    let bright_index = (frame % 4) as usize;
   188	    let points = [(9, 2), (16, 9), (9, 16), (2, 9)];
   189	
   190	    for (index, (x, y)) in points.iter().enumerate() {
   191	        let alpha = if index == bright_index { 255 } else { 90 };
   192	        let color = [primary[0], primary[1], primary[2], alpha];
   193	        draw_disc(&mut rgba, *x, *y, 2.5, color);
   194	    }
   195	    draw_disc(
   196	        &mut rgba,
   197	        center.round() as u32,
   198	        center.round() as u32,
   199	        1.7,
   200	        [primary[0], primary[1], primary[2], 130],
   201	    );
   202	
   203	    rgba
   204	}
   205	
   206	fn error_icon(primary: [u8; 4]) -> Vec<u8> {
   207	    let mut rgba = dot_icon(primary, None);
   208	    for y in 5..12 {
   209	        draw_disc(&mut rgba, 9, y, 1.0, [255, 255, 255, 255]);
   210	    }
   211	    draw_disc(&mut rgba, 9, 14, 1.2, [255, 255, 255, 255]);
   212	    rgba
   213	}
   214	
   215	fn draw_disc(rgba: &mut [u8], center_x: u32, center_y: u32, radius: f32, color: [u8; 4]) {
   216	    for y in 0..ICON_SIZE {
   217	        for x in 0..ICON_SIZE {
   218	            let dx = x as f32 - center_x as f32;
   219	            let dy = y as f32 - center_y as f32;
   220	            if (dx * dx + dy * dy).sqrt() <= radius {
   221	                set_pixel(rgba, x, y, color);
   222	            }
   223	        }
   224	    }
   225	}
   226	
   227	fn set_pixel(rgba: &mut [u8], x: u32, y: u32, color: [u8; 4]) {
   228	    let index = ((y * ICON_SIZE + x) * 4) as usize;
   229	    rgba[index..index + 4].copy_from_slice(&color);
   230	}
