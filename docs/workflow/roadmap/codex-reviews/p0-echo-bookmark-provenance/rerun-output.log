   153	        onDropRef.current(fileNames, position);
   154	
   155	        // G3-E3 P0: register every dropped path as a user-authorized
   156	        // bookmark so subsequent reveal_in_finder / open_path calls are
   157	        // admitted by the Rust side. We fire-and-forget per path —
   158	        // individual failures (validator rejection, IPC down) are
   159	        // logged and do NOT abort the drop UX.
   160	        const client = finderClientRef.current;
