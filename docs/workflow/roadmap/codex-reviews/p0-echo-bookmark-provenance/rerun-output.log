   138	        // For a real desktop app, you might need to use Tauri's file dialog
   139	        // or save files to a temp location first
   140	        const fileNames = Array.from(files).map(f => f.name);
   141	        const position = { x: e.clientX, y: e.clientY };
   142	
   143	        console.log('📂 [useFileDrop] Files dropped:', fileNames, 'at', position);
   144	
   145	        // Store File objects in a global map so they can be accessed later
   146	        // This is needed because we can't pass File objects through the path string
   147	        const fileMap = (window as unknown as { __droppedFiles?: Map<string, File> }).__droppedFiles || new Map<string, File>();
