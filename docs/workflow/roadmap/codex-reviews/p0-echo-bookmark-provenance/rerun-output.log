    96	        console.log('📂 [useFileDrop] Files entered window');
    97	        onHoverRef.current?.(true);
    98	        onEnterRef.current?.();
    99	      }
   100	    };
   101	
   102	    const handleDragOver = (e: DragEvent) => {
   103	      e.preventDefault();
