    63	    onDropRef.current = onDrop;
    64	  }, [onDrop]);
    65	
    66	  useEffect(() => {
    67	    onHoverRef.current = onHover;
    68	  }, [onHover]);
    69	
    70	  useEffect(() => {
    71	    onEnterRef.current = onEnter;
    72	  }, [onEnter]);
    73	
    74	  useEffect(() => {
    75	    onLeaveRef.current = onLeave;
    76	  }, [onLeave]);
    77	
    78	  useEffect(() => {
    79	    finderClientRef.current = finderClient;
    80	  }, [finderClient]);
    81	
    82	  // Setup HTML5 drag-drop event listeners
    83	  useEffect(() => {
    84	    if (typeof window === 'undefined' || !enabled) {
    85	      return;
    86	    }
