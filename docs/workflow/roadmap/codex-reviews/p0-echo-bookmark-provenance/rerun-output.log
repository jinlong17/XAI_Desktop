     1	//! Finder collaboration commands (G3-E3).
     2	//!
     3	//! Three minimal user-initiated path actions:
     4	//!
     5	//! - `reveal_in_finder` — opens a Finder window highlighting the path.
     6	//! - `open_path` — opens the path in its default handler (file → app).
     7	//! - `remove_item_from_grid` — pure logical removal; does NOT touch the
     8	//!   user's filesystem. The Organizer plugin owns the "send file to
     9	//!   Trash" decision and must surface a confirmation UI before invoking
    10	//!   any future destructive variant.
    11	//!
    12	//! All commands enforce a window-origin allow-list and validate the path
    13	//! against the user-reachable root allow-list (see `validate_user_path`)
    14	//! before touching the platform layer.
    15	
    16	use std::path::{Component, Path, PathBuf};
    17	
    18	use serde::Deserialize;
    19	
    20	use crate::commands::bookmarks::{is_path_bookmarked, BookmarkRegistry};
    21	use crate::error::{AppError, AppResult};
    22	
    23	pub(crate) const FINDER_ALLOWED_WINDOWS: &[&str] = &["main", "control", "console"];
    24	
    25	/// User-reachable filesystem roots a desktop file/app drop or open-panel
    26	/// selection can produce on macOS. Paths outside these roots are rejected
    27	/// for now — full bookmark-store enforcement is a later gate. On non-macOS
    28	/// targets only `/tmp/` is admitted, mirroring the existing macOS-only
    29	/// behavior of the platform commands.
    30	#[cfg(target_os = "macos")]
    31	const USER_REACHABLE_ROOTS: &[&str] = &["/Users/", "/Applications/", "/Volumes/", "/tmp/"];
    32	
    33	#[cfg(not(target_os = "macos"))]
    34	const USER_REACHABLE_ROOTS: &[&str] = &["/tmp/"];
    35	
    36	fn is_finder_window_allowed(label: &str) -> bool {
    37	    if FINDER_ALLOWED_WINDOWS.contains(&label) {
    38	        return true;
    39	    }
    40	    label.starts_with("grid_")
    41	}
    42	
    43	fn ensure_finder_window_allowed(label: &str) -> AppResult<()> {
    44	    if is_finder_window_allowed(label) {
    45	        return Ok(());
    46	    }
    47	    Err(AppError::SyncCapabilityDenied(format!(
    48	        "window `{label}` is not allowed to invoke Finder commands"
    49	    )))
    50	}
    51	
    52	/// Validate `raw` looks like a user-authorized absolute path and return its
    53	/// lexically-normalized canonical form.
    54	///
    55	/// Rules:
    56	/// - rejects empty / NUL / whitespace-only input.
    57	/// - rejects relative paths and any `..` parent-dir segment (even when the
    58	///   raw string would normalize away, e.g. `/Users/me/../etc/passwd`).
    59	/// - rejects paths whose normalized form does NOT start with one of the
    60	///   allowed user-reachable roots (`/Users/`, `/Applications/`, `/Volumes/`,
    61	///   `/tmp/` on macOS; only `/tmp/` on other targets).
    62	///
    63	/// Returns the normalized `PathBuf` on success. This is a *lexical*
    64	/// normalization (`Path::components`) rather than `canonicalize()` because
    65	/// `canonicalize` requires the path to exist on disk; that stricter check
    66	/// is a follow-up once a bookmark store lands.
    67	pub(crate) fn validate_user_path(raw: &str) -> AppResult<PathBuf> {
    68	    if raw.trim().is_empty() {
    69	        return Err(AppError::SyncInvalidInput(
    70	            "path must be non-empty".into(),
    71	        ));
    72	    }
    73	    if raw.contains('\0') {
    74	        return Err(AppError::SyncInvalidInput(
    75	            "path must not contain NUL".into(),
    76	        ));
    77	    }
    78	
    79	    let path = Path::new(raw);
    80	    if !path.is_absolute() {
    81	        return Err(AppError::SyncInvalidInput(format!(
    82	            "path must be absolute: `{raw}`"
    83	        )));
    84	    }
    85	
    86	    // Walk components, refusing any `..` (parent) segment. This catches
    87	    // both `/Users/me/../etc/passwd` and `/Applications/../etc/passwd`.
    88	    let mut normalized = PathBuf::new();
    89	    for component in path.components() {
    90	        match component {
    91	            Component::ParentDir => {
    92	                return Err(AppError::SyncInvalidInput(format!(
    93	                    "path must not contain `..` segments: `{raw}`"
    94	                )));
    95	            }
    96	            Component::CurDir => {
    97	                // Drop `.` — harmless lexical no-op.
    98	            }
    99	            other => normalized.push(other.as_os_str()),
   100	        }
   101	    }
   102	
   103	    let normalized_str = normalized.to_string_lossy().to_string();
   104	    let under_allowed_root = USER_REACHABLE_ROOTS
   105	        .iter()
   106	        .any(|root| normalized_str.starts_with(root));
   107	
   108	    if !under_allowed_root {
   109	        return Err(AppError::SyncCapabilityDenied(format!(
   110	            "path `{normalized_str}` is not under a user-reachable root"
   111	        )));
   112	    }
   113	
   114	    Ok(normalized)
   115	}
   116	
   117	/// Enforce honest user-authorized provenance for a finder action.
   118	///
   119	/// Two-stage gate:
   120	///
   121	/// 1. `validate_user_path` lexically normalizes and shape-checks the raw
   122	///    input (absolute, no `..`, under a user-reachable root).
   123	/// 2. `BookmarkRegistry` lookup asserts the user explicitly registered
   124	///    the canonical path through a prior drag-drop or open-panel action.
   125	///
   126	/// Stage 1 alone is NOT honest provenance — it only narrows the attack
   127	/// surface. The contract in `docs/contracts/tauri-commands-v0.md` §4
   128	/// requires that "all path access must come from user drop/open panel
   129	/// or authorized bookmark". This helper raises the implementation to
   130	/// match the contract.
   131	fn ensure_path_authorized(
   132	    raw: &str,
   133	    registry: &BookmarkRegistry,
   134	) -> AppResult<PathBuf> {
   135	    let canonical = validate_user_path(raw)?;
   136	    if !is_path_bookmarked(registry, &canonical) {
   137	        return Err(AppError::SyncCapabilityDenied(format!(
   138	            "path `{}` has no user-authorized bookmark",
   139	            canonical.display()
   140	        )));
   141	    }
   142	    Ok(canonical)
   143	}
