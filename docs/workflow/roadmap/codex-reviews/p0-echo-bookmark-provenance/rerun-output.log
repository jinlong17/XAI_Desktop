   200	export function getFileInfoFromPath(filePath: string): {
   201	  name: string;
   202	  extension: string;
   203	  type: 'file' | 'folder' | 'app';
   204	} {
   205	  const parts = filePath.split('/');
   206	  const name = parts[parts.length - 1] || 'Unknown';
   207	  const extension = name.includes('.') ? name.split('.').pop()?.toLowerCase() || '' : '';
   208	
   209	  // Determine type
   210	  let type: 'file' | 'folder' | 'app' = 'file';
   211	  if (extension === 'app') {
   212	    type = 'app';
   213	  } else if (!extension && !name.includes('.')) {
   214	    // No extension might be a folder (heuristic)
   215	    type = 'folder';
   216	  }
   217	
   218	  return { name, extension, type };
   219	}
