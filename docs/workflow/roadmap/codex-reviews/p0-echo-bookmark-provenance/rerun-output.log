   106	      if (e.dataTransfer) {
   107	        e.dataTransfer.dropEffect = 'copy';
   108	      }
   109	    };
   110	
   111	    const handleDragLeave = (e: DragEvent) => {
   112	      e.preventDefault();
   113	      e.stopPropagation();
   114	
   115	      dragCounterRef.current--;
   116	
   117	      // Only trigger leave when all nested elements have been left
   118	      if (dragCounterRef.current === 0 && isDraggingRef.current) {
   119	        isDraggingRef.current = false;
   120	        console.log('📂 [useFileDrop] Drag left window');
   121	        onHoverRef.current?.(false);
   122	        onLeaveRef.current?.();
   123	      }
   124	    };
   125	
   126	    const handleDrop = (e: DragEvent) => {
   127	      e.preventDefault();
   128	      e.stopPropagation();
   129	
   130	      dragCounterRef.current = 0;
   131	      isDraggingRef.current = false;
   132	      onHoverRef.current?.(false);
