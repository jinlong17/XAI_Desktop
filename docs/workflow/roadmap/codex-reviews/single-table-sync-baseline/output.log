    22	import { assertRepoRecord } from "./repo-utils";
    23	import type {
    24	  Repo,
    25	  RepoRecord,
    26	  RepoTransaction,
    27	} from "./types";
    28	
    29	/** A single pending sync mutation queued for push. */
    30	export interface OutboxEntry extends RepoRecord {
    31	  entityType: "sync.outbox";
    32	  /** Monotonic commit sequence assigned at enqueue time. */
    33	  commitSeq: number;
    34	  /** Deterministic mutation identifier — used for de-duplication on retry. */
    35	  mutationId: string;
    36	  /** Entity slug being mutated, e.g. `productivity.todo`. */
    37	  targetEntityType: string;
    38	  /** Entity id being mutated. */
    39	  targetEntityId: string;
    40	  /** Operation kind. */
    41	  op: "put" | "delete";
    42	  /** Encrypted payload envelope, opaque to the outbox. */
    43	  payload: string;
    44	  /** When the engine last attempted a push. */
    45	  lastAttemptAt?: string;
    46	  /** Retry counter; the engine bounds this. */
    47	  retryCount: number;
    48	  /** Optional revision used by the conditional-write conflict path. */
    49	  baseRevision?: number;
    50	}
    51	
    52	export interface EnqueueOutboxInput<T extends RepoRecord> {
    53	  entityRepo: Repo<T>;
    54	  outboxRepo: Repo<OutboxEntry>;
    55	  entity: T;
    56	  op: "put" | "delete";
    57	  payload: string;
    58	  mutationId: string;
    59	  baseRevision?: number;
    60	  nowIso?: () => string;
    61	  nextCommitSeq: () => number;
    62	}
    63	
    64	/**
    65	 * Atomically write `entity` and an outbox row. The `entityRepo`
    66	 * transaction wraps both writes so a crash mid-state cannot leave one
    67	 * without the other.
    68	 */
    69	export async function enqueueOutboxEntry<T extends RepoRecord>(
    70	  input: EnqueueOutboxInput<T>,
    71	): Promise<OutboxEntry> {
    72	  const nowIso = input.nowIso ?? (() => new Date().toISOString());
    73	  const commitSeq = input.nextCommitSeq();
    74	  if (!Number.isInteger(commitSeq) || commitSeq < 1) {
    75	    throw new Error("E3008: outbox commitSeq must be a positive integer");
    76	  }
    77	  const entry: OutboxEntry = {
    78	    id: `outbox_${input.mutationId}`,
    79	    entityType: "sync.outbox",
    80	    schemaVersion: 1,
    81	    createdAt: nowIso(),
    82	    updatedAt: nowIso(),
    83	    syncScope: "account-sync",
    84	    commitSeq,
    85	    mutationId: input.mutationId,
    86	    targetEntityType: input.entity.entityType,
    87	    targetEntityId: input.entity.id,
    88	    op: input.op,
    89	    payload: input.payload,
    90	    retryCount: 0,
    91	    baseRevision: input.baseRevision,
    92	  };
