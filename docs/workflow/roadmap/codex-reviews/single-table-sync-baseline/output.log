    94	
    95	  await input.entityRepo.transaction(async (entityTx: RepoTransaction<T>) => {
    96	    if (input.op === "put") {
    97	      await entityTx.put(input.entity);
    98	    } else {
    99	      await entityTx.delete(input.entity.id);
   100	    }
   101	    // The outbox lives in its own namespace, so we open a nested
   102	    // transaction on the outbox repo to ensure ordering. Driver
   103	    // semantics: the outer (entity) transaction commits last, so a
   104	    // crash between the two phases on a SQLite backend rolls back the
   105	    // entity write via the outer transaction's snapshot.
   106	    await input.outboxRepo.transaction(async (outboxTx) => {
   107	      await outboxTx.put(entry);
   108	    });
   109	  });
   110	
   111	  return entry;
   112	}
   113	
   114	export interface OutboxBatchOptions {
   115	  limit?: number;
   116	}
   117	
   118	/** Return the next batch of outbox entries ordered by `commitSeq`. */
   119	export async function nextOutboxBatch(
   120	  outboxRepo: Repo<OutboxEntry>,
   121	  options: OutboxBatchOptions = {},
   122	): Promise<OutboxEntry[]> {
   123	  return outboxRepo.list({
   124	    entityType: "sync.outbox",
   125	    orderBy: { field: "commitSeq", direction: "asc" },
   126	    limit: options.limit,
   127	  });
   128	}
