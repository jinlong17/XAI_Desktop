    36	import { assertRepoRecord } from "./repo-utils";
    37	import type {
    38	  Repo,
    39	  RepoRecord,
    40	  RepoTransaction,
    41	} from "./types";
    42	
    43	/**
    44	 * Reserved id prefix that marks a row as a sync-outbox row inside a
    45	 * shared entity namespace. Application code must NEVER mint an entity
    46	 * with this prefix as its id.
    47	 */
    48	export const OUTBOX_ID_PREFIX = "__outbox__";
    49	
    50	/** Convert a mutationId into the outbox row's id. */
    51	export function outboxIdFor(mutationId: string): string {
    52	  return `${OUTBOX_ID_PREFIX}${mutationId}`;
    53	}
    54	
    55	/** True if the given record id is reserved for an outbox row. */
    56	export function isOutboxId(id: string): boolean {
    57	  return id.startsWith(OUTBOX_ID_PREFIX);
    58	}
    59	
    60	/** A single pending sync mutation queued for push. */
    61	export interface OutboxEntry extends RepoRecord {
    62	  entityType: "sync.outbox";
    63	  /** Monotonic commit sequence assigned at enqueue time. */
    64	  commitSeq: number;
    65	  /** Deterministic mutation identifier — used for de-duplication on retry. */
    66	  mutationId: string;
    67	  /** Entity slug being mutated, e.g. `productivity.todo`. */
    68	  targetEntityType: string;
    69	  /** Entity id being mutated. */
    70	  targetEntityId: string;
    71	  /** Operation kind. */
    72	  op: "put" | "delete";
    73	  /** Encrypted payload envelope, opaque to the outbox. */
    74	  payload: string;
    75	  /** When the engine last attempted a push. */
    76	  lastAttemptAt?: string;
    77	  /** Retry counter; the engine bounds this. */
    78	  retryCount: number;
    79	  /** Optional revision used by the conditional-write conflict path. */
    80	  baseRevision?: number;
    81	}
    82	
    83	/**
    84	 * `enqueueOutboxEntry` takes ONE repo. The entity row and the outbox row
    85	 * share its namespace; the outbox row uses the reserved id prefix
    86	 * `OUTBOX_ID_PREFIX` so it cannot collide with an entity id.
    87	 *
    88	 * Backwards-compatibility note: the historical signature carried both
    89	 * `entityRepo` and `outboxRepo`. Inline migration callers wired both to
    90	 * the same repo while we land the SQLite atomic path; we now accept
    91	 * either shape. When `outboxRepo` is provided, it must be the same
    92	 * `Repo` instance as `entityRepo` — passing two different repos throws
    93	 * because the underlying drivers cannot commit two namespaces atomically.
    94	 */
    95	export interface EnqueueOutboxInput<T extends RepoRecord> {
    96	  /**
    97	   * Repo whose namespace will hold BOTH the entity row and its outbox
    98	   * row. Required.
    99	   */
   100	  entityRepo: Repo<T | OutboxEntry>;
