   324	
   325	/// Atomically apply a batch of put/delete operations against a single
   326	/// namespace inside ONE SQLite transaction. If any entry fails validation
   327	/// or backend execution, the entire batch rolls back — no partial write.
   328	///
   329	/// This is the primitive that lets the TS `createTauriRepo.transaction(fn)`
   330	/// shim deliver a real same-transaction guarantee on the on-disk SQLite
   331	/// path (G2.6 P0 fix). The shim buffers writes in TS, then issues one
   332	/// `db_put_batch` call at commit time.
   333	#[tauri::command]
   334	pub async fn db_put_batch(
   335	    window: tauri::WebviewWindow,
   336	    state: tauri::State<'_, DatabaseState>,
   337	    input: DbPutBatchInput,
   338	) -> AppResult<()> {
   339	    ensure_database_window_allowed(window.label())?;
   340	    apply_put_batch(&state, &input)
   341	}
   342	
   343	/// Inner driver for `db_put_batch`. Factored out so the Tauri command and
   344	/// unit tests can share the validation + transactional execution path.
   345	fn apply_put_batch(state: &DatabaseState, input: &DbPutBatchInput) -> AppResult<()> {
   346	    validate_namespace(&input.namespace)?;
   347	
   348	    // Validate every entry up-front so a malformed payload aborts before
   349	    // we touch the connection. This keeps the contract: `db_put_batch`
   350	    // either applies all entries or none.
   351	    for entry in &input.entries {
   352	        validate_id(&entry.id)?;
   353	        match entry.op.as_str() {
   354	            "put" => {
   355	                if entry.json.is_none() || entry.updated_at_ms.is_none() {
   356	                    return Err(AppError::DatabaseInvalidInput(format!(
   357	                        "batch entry id={} op=put requires json + updatedAtMs",
   358	                        entry.id
   359	                    )));
   360	                }
   361	            }
   362	            "delete" => {}
   363	            other => {
   364	                return Err(AppError::DatabaseInvalidInput(format!(
   365	                    "batch entry id={} has unknown op `{other}` (expected put|delete)",
   366	                    entry.id
   367	                )));
   368	            }
   369	        }
   370	    }
   371	
   372	    state.with_conn_mut(|conn| {
   373	        let tx = conn
   374	            .transaction()
   375	            .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   376	
   377	        for entry in &input.entries {
   378	            match entry.op.as_str() {
   379	                "put" => {
   380	                    let json = entry.json.as_ref().expect("validated above");
   381	                    let updated_at_ms = entry.updated_at_ms.expect("validated above");
   382	                    tx.execute(
   383	                        UPSERT_RECORD_SQL,
   384	                        params![input.namespace, entry.id, json, updated_at_ms],
   385	                    )
   386	                    .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   387	                }
   388	                "delete" => {
   389	                    tx.execute(
   390	                        DELETE_RECORD_SQL,
   391	                        params![input.namespace, entry.id],
   392	                    )
   393	                    .map_err(|err| AppError::DatabaseBackend(err.to_string()))?;
   394	                }
