   104	   * as `entityRepo`. Two separate repos cannot be committed atomically
   105	   * against the on-disk SQLite driver and are rejected at runtime.
   106	   */
   107	  outboxRepo?: Repo<T | OutboxEntry>;
   108	  entity: T;
   109	  op: "put" | "delete";
   110	  payload: string;
   111	  mutationId: string;
   112	  baseRevision?: number;
   113	  nowIso?: () => string;
   114	  nextCommitSeq: () => number;
   115	}
   116	
   117	/**
   118	 * Atomically write `entity` and an outbox row inside a single
   119	 * `Repo.transaction(fn)` call. The transaction guarantees that either
   120	 * both rows are committed or neither — see the module-level header for
   121	 * the per-driver atomicity model.
   122	 */
   123	export async function enqueueOutboxEntry<T extends RepoRecord>(
   124	  input: EnqueueOutboxInput<T>,
   125	): Promise<OutboxEntry> {
