    28	function fakeStorage() {
    29	  const records = new Map<string, string>();
    30	  const calls: CallLog[] = [];
    31	
    32	  function key(namespace: string, id: string) {
    33	    return `${namespace}␀${id}`;
    34	  }
    35	
    36	  async function invoke<T>(
    37	    cmd: string,
    38	    args?: Record<string, unknown>,
    39	  ): Promise<T> {
    40	    calls.push({ cmd, args });
    41	    if (cmd === "db_init") {
    42	      const ns = args!.namespace as string;
    43	      return { namespace: ns, path: `/tmp/${ns}.db` } as unknown as T;
    44	    }
    45	    if (cmd === "db_put") {
    46	      const input = args!.input as {
    47	        namespace: string;
    48	        id: string;
    49	        json: string;
    50	      };
    51	      records.set(key(input.namespace, input.id), input.json);
    52	      return undefined as unknown as T;
    53	    }
    54	    if (cmd === "db_get") {
    55	      const input = args!.input as { namespace: string; id: string };
    56	      const raw = records.get(key(input.namespace, input.id));
    57	      return (raw ?? null) as unknown as T;
    58	    }
    59	    if (cmd === "db_list") {
    60	      const input = args!.input as { namespace: string };
    61	      const prefix = `${input.namespace}␀`;
    62	      const out: string[] = [];
    63	      for (const [k, v] of records) {
    64	        if (k.startsWith(prefix)) out.push(v);
    65	      }
    66	      out.sort();
    67	      return out as unknown as T;
    68	    }
    69	    if (cmd === "db_delete") {
    70	      const input = args!.input as { namespace: string; id: string };
    71	      records.delete(key(input.namespace, input.id));
    72	      return undefined as unknown as T;
    73	    }
    74	    if (cmd === "db_put_batch") {
    75	      const input = args!.input as {
    76	        namespace: string;
    77	        entries: Array<
    78	          | { op: "put"; id: string; json: string; updatedAtMs: number }
    79	          | { op: "delete"; id: string }
    80	        >;
    81	      };
    82	      // Stage into a snapshot to mimic the Rust BEGIN/COMMIT path so a
    83	      // throw inside this branch leaves `records` untouched.
    84	      const staged = new Map(records);
    85	      for (const entry of input.entries) {
    86	        if (entry.op === "put") {
    87	          if (!entry.json || typeof entry.updatedAtMs !== "number") {
    88	            throw new Error(
    89	              `E1301: batch entry id=${entry.id} op=put requires json + updatedAtMs`,
    90	            );
    91	          }
    92	          staged.set(key(input.namespace, entry.id), entry.json);
    93	        } else if (entry.op === "delete") {
    94	          staged.delete(key(input.namespace, entry.id));
    95	        } else {
    96	          throw new Error(
    97	            `E1301: batch entry has unknown op (expected put|delete)`,
    98	          );
    99	        }
   100	      }
   101	      records.clear();
   102	      for (const [k, v] of staged) records.set(k, v);
   103	      return undefined as unknown as T;
   104	    }
   105	    throw new Error(`unknown cmd: ${cmd}`);
   106	  }
   107	
   108	  return { invoke, calls, records };
   109	}
