id: browser.pid, closeReason: browser.closeReason ?? null, processExit: browser.processExit ?? null } : null,\n    runtimeErrors: runtimeErrors.length, runtimeErrorSamples: runtimeErrors.slice(0, 6).map((entry) => ({ ...entry, text: entry.text.slice(0, 240) })),\n    consoleWarnings: consoleWarnings.length, consoleWarningsBySource: warningGroups,\n    dialogs, navigationRequests, unusedDialogPlans: dialogPlan, artifacts: artifacts.map((entry) => ({ file: entry.file, sha256: entry.sha256 })), keyboardAudit, network: networkSeen,\n    ...(harnessError ? { error: String(harnessError?.stack ?? harnessError).slice(0, 1500), checkId: harnessError?.checkId ?? null, checkKind: harnessError?.checkKind ?? null } : {}),\n  });\n  process.exitCode = harnessError ? 1 : productFailures.length ? 2 : 0;\n  const q1PrimaryExit=process.exitCode;\n  const q1Final={status:\"UNQUALIFIED\",primaryExit:q1PrimaryExit,primaryError:harnessError?errorInfo(harnessError):null};\n  await finalizeEvidence({journal:q1Journal,status:q1Final,resultName:\"evidence-finalization\",finalizers:[[\"owned-browsers\",async()=>{const outcomes=[];for(const owner of q1Owners)if(!owner.closed)outcomes.push(await closeOwned(owner,browser?()=>browser.send(\"Browser.close\"):null,q1Record));return{complete:outcomes.every(x=>x.complete),errors:outcomes.flatMap(x=>x.errors),outcomes};}],[\"server-close\",()=>new Promise((r,j)=>{if(!server)return r();server.closeAllConnections?.();server.close(e=>e&&e.code!==\"ERR_SERVER_NOT_RUNNING\"?j(e):r());})],[\"directory-retention\",()=>{q1Record(\"directory-retained\",{path:directory,reason:\"descendant quiescence uncertain; no profile deletion\"});return{complete:true,retained:directory};}]]});\n  process.exitCode=q1Final.cleanupErrors.length||q1Final.persistenceErrors.length?1:q1PrimaryExit;\n  const summary = verdicts.map((entry) => `${entry.id}=${entry.requirementHolds ? \"PASS\" : \"FAIL\"}`).join(\" \");\n  console.log(`${harnessError ? \"HARNESS-FAIL\" : \"VALID\"} ${r