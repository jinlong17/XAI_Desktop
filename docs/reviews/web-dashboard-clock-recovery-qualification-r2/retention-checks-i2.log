ure.targets.some((target) => /Export|导出/.test(target.name ?? \"\")), evidence: { clock: measure.clock, screenshot: shot.file } });\n    // The existing pet control is exercised at a supported width; resize the same document without reloading.\n    if (width === 768) {\n      const petName = facts0.labels[lang].nav.pet;\n      await clickOne(page, `[...document.querySelectorAll('.app-rail .rail-bottom .rail-btn')].filter((button) => button.getAttribute('aria-label') === ${JSON.stringify(petName)})`, `${id}:hide-pet-by-product-rail-button`);\n      const hidden = await geometry(page, `${id}:pet-hidden`, width);\n      pre(`${id}:trusted-product-pet-toggle-hid-pet`, hidden.pet === null, { petName, hidden: hidden.pet });\n      await viewport(page, 375);\n      await geometry(page, `${id}:pet-hidden-resized`, 375);\n      await screenshot(page, `${lang}-375-both-failed-pet-hidden-after-768-toggle`, { state: \"same document after trusted pet toggle at 768 then resize to 375\", lang });\n    }\n  }\n}\n\n/** Contract r2 §9 responsive centre-hit rule, independently measured with the pet on and hidden. */\nasync function geometryDetailed(page, id, width, petHidden) {\n  const axNames=new Map((await page.cdp('Accessibility.getFullAXTree')).nodes.filter(n=>!n.ignored&&n.backendDOMNodeId&&n.name).map(n=>[n.backendDOMNodeId,n.name.value]));\n  const doc=await page.cdp('DOM.getDocument',{depth:0});\n  const reloadBlocks=[];\n  for(const field of ['style','timezone']) {\n    const found=await page.cdp('DOM.querySelectorAll',{nodeId:doc.root.nodeId,selector:`${CLOCK_SCOPE} [data-clock-recovery=\"${field}\"]`});\n    for(const nodeId of found.nodeIds) {\n      const remote=await page.cdp('DOM.resolveNode',{nodeId});\n      const text=await page.cdp('Runtime.callFunctionOn',{objectId:remote.object.objectId,functionDeclaration:'function(){return this.textContent;}',returnByValue:true});\n      const buttons=await page.cdp('DOM.querySelectorAll',{nodeId,selector:'button'});\n      const actions=[];\n      for(const buttonId of buttons.nodeIds) {\n        const node=await page.cdp('DOM.describeNode',{nodeId:buttonId});\n        const obj=await page.cdp('DOM.resolveNode',{nodeId:buttonId});\n        const visible=await page.cdp('Runtime.callFunctionOn',{objectId:obj.object.objectId,functionDeclaration:'function(){return this.innerText;}',returnByValue:true});\n        actions.push({visible:visible.result.value,accessible:axNames.get(node.node.backendNodeId)??null});\n      }\n      reloadBlocks.push({field,text:text.result.value,actions});\n    }\n  }\n  // Q1_RELOAD_JUDGE_START — used identically by the isolated controls.\n  const judgeReload = (blocks,field,lang,inlineExport) => {\n    const label=lang==='zh'?(field==='style'?'时钟样式':'时钟时区'):(field==='style'?'Clock style':'Clock timezone');\n    const name=(lang==='zh'?'重新读取 ':'Reload ')+label;\n    const message=lang==='zh'?`已保存的${label}不可用。请重新读取；这不是新的未保存更改。`:`Saved ${label} is unavailable. Reload it; this is not a new unsaved change.`;\n    const own=blocks.filter(b=>b.field===field);\n    return blocks.length===1&&own.length===1&&own[0].text.includes(message)&&own[0].actions.length===1&&own[0].actions[0].visible===name&&own[0].actions[0].accessible===name&&!inlineExport;\n  };\n  // Q1_RELOAD_JUDGE_END\n  const value = await evaluate(page, `(() => {\n    const pane = document.querySelector('.module-dashboard');\n    const widget = document.querySelector('.widget-shell[data-widget-id=\"clock\"]');\n    const rect = (element) => { if (!element) return null; const r = element.getBoundingClientRect(); return { x:r.x,y:r.y,width:r.width,height:r.height,right:r.right,bottom:r.bottom }; };\n    const controls = [...document.querySelectorAll(${JSON.stringify(CLOCK_SCOPE + ' button')})].filter((element) => element.getClientRects().length > 0).map((element) => {\n      element.scrollIntoView({ block:'center', inline:'nearest', behavior:'instant' });\n      const r = element.getBoundingClientRect(); cons