value.topbarStatus });\n  value.reloadBlocks=reloadBlocks;\n  value.reloadResult={style:judgeReload(reloadBlocks,'style',id.split(':')[1],value.inlineExport),timezone:judgeReload(reloadBlocks,'timezone',id.split(':')[1],value.inlineExport)};\n  record('responsive-geometry', { id, width, petHidden, ...value });\n  return value;\n}\nasync function runGeometry() {\n  const page = mainPage;\n  const allStates = ['clean','style-failed','timezone-failed','both-failed','source-style','source-timezone'];\n  const probeState = process.env.XAI_NATIVE_GEOMETRY_PROBE ?? null;\n  const probeLang = process.env.XAI_NATIVE_GEOMETRY_LANG ?? 'en';\n  if (probeState && (!process.env.XAI_NATIVE_EVIDENCE_DIR || !allStates.includes(probeState) || !['en','zh'].includes(probeLang))) throw Error('PRECONDITION: bounded geometry probes require a valid state/language and external evidence directory');\n  const languages = probeState ? [probeLang] : ['en','zh'];\n  const widths = probeState ? [375] : [375,414,768,1024,1440];\n  const states = probeState ? [probeState] : allStates;\n  record('responsive-coverage-plan', { languages,widths,states,subsetDevelopmentProbe:Boolean(probeState),petOnAndHidden:true,defaultDashboardOrder:DEFAULT_DASH_ORDER });\n  for (const lang of languages) for (const width of widths) for (const stateName of states) {\n    const id = `responsive:${lang}:${width}:${stateName}`;\n    await viewport(page,768);\n    const extra = stateName === 'source-style' ? { [CLOCK_STYLE]:'bogus' } : stateName === 'source-timezone' ? { [CLOCK_TZ]:'mars' } : {};\n    await freshClock(page,id,lang,extra,{ order:null });\n    const defaultOrder = await evaluate(page, `({ persisted:__native.native.get(${JSON.stringify(DASH_ORDER)}),rendered:[...document.querySelectorAll('.module-dashboard .widget-shell[data-widget-id]')].map((element)=>element.getAttribute('data-widget-id')) })`);\n    pre(`${id}:default-eleven-widget-order`, defaultOrder.persisted === null && JSON.stringify(defaultOrder.re