{"name":"validation-source-freeze","iteration":1,"sources":{"evidence-retention.mjs":{"sha256":"bd148523a73b789baeddbc0345b2c810d9735deb83142f2a4f8a7ef549c252e0","source":"/** Evidence lifecycle only. No pixel measurement, fixture, or product semantics. */\nimport {openSync,closeSync,writeSync,fsyncSync,readFileSync,realpathSync,lstatSync} from 'node:fs';\nimport {spawn} from 'node:child_process';\nimport {isDeepStrictEqual as equal} from 'node:util';\nexport const errorInfo=e=>({name:e?.name??'Error',message:String(e?.message??e),code:e?.code??null,stack:e?.stack??null});\nexport function exclusiveWrite(path,bytes,io={openSync,closeSync,writeSync,fsyncSync}) {\n const fd=io.openSync(path,'wx');try{writeAll(fd,Buffer.from(bytes),io);io.fsyncSync(fd);}finally{io.closeSync(fd);}\n}\nfunction writeAll(fd,bytes,io){let offset=0;while(offset<bytes.length){const n=io.writeSync(fd,bytes,offset,bytes.length-offset);if(n<=0)throw Error('Zero evidence write');offset+=n;}}\nexport function createJournal(path,io={openSync,closeSync,writeSync,fsyncSync}) {\n const fd=io.openSync(path,'wx');const state={path,records:[],persistenceErrors:[],closed:false};\n const failure=e=>{state.persistenceErrors.push(errorInfo(e));process.stderr.write('EVIDENCE PERSISTENCE FAILED '+JSON.stringify(errorInfo(e))+'\\n');};\n return Object.assign(state,{\n  record(name,value={}){const item={name,...value};state.records.push(item);try{writeAll(fd,Buffer.from(JSON.stringify(item)+'\\n'),io);io.fsyncSync(fd);}catch(e){failure(e);throw e;}return item;},\n  flush(){try{io.fsyncSync(fd);}catch(e){failure(e);throw e;}},\n  close(){if(state.closed)return;try{io.fsyncSync(fd);}catch(e){failure(e);throw e;}finally{state.closed=true;io.closeSync(fd);}},\n });\n}\nexport function readJournal(path){const text=readFileSync(path,'utf8'),lines=text.split('\\n'),tail=lines.pop(),records=[];let invalid=null;for(const [index,line] of lines.entries()){try{records.push(JSON.parse(line));}catch(e){invalid={index,line,error:errorInfo(e)};break;}}return{records,tail,invalid,complete:tail===''&&!invalid};}\nexport async function bounded(label,operation,ms=2000){if(ms>5000||ms<=0)throw Error('Operation deadline outside policy');let timer;try{return await Promise.race([Promise.resolve().then(operation),new Promise((_,reject)=>{timer=setTimeout(()=>reject(Object.assign(Error(label+' deadline'),{code:'DEADLINE'})),ms);})]);}finally{clearTimeout(timer);}}\nexport function trackOwned(proc,profile,record){\n const safeRecord=(name,value)=>{try{record(name,value);}catch(e){owner.recordErrors.push(errorInfo(e));}};\n const owner={recordErrors:[],proc,pid:proc.pid??null,profile,canonical:profile?realpathSync(profile):null,closed:false,exit:null,startupError:null};\n owner.closedPromise=new Promise(resolve=>{proc.once('error',e=>{owner.startupError=errorInfo(e);safeRecord('owned-startup-error',owner.startupError);});proc.once('close',(code,signal)=>{owner.closed=true;owner.exit={code,signal};safeRecord('owned-streams-closed',{pid:owner.pid,...owner.exit});resolve(owner.exit);});});\n safeRecord('owned-acquired',{pid:owner.pid,profile,canonical:owner.canonical});return owner;\n}\nexport async function closeOwned(owner,send,record,{termMs=1500,killMs=1500,closeMs=500}={}){\n const errors=[...(owner?.recordErrors??[])];const note=(name,value)=>{try{record(name,value);}catch(e){errors.push(errorInfo(e));}};\n if(!owner)return{complete:true,errors,profileRetained:null};\n if(send)try{await bounded('CDP close',send,closeMs);}catch(e){errors.push(errorInfo(e));note('close-command-error',errorInfo(e));}\n if(!owner.closed){note('owned-signal',{pid:owner.pid,signal:'SIGTERM'});try{owner.proc.kill('SIGTERM');await bounded('owned TERM exit and streams',()=>owner.closedPromise,termMs);}catch(e){errors.push(errorInfo(e));}}\n if(!owner.closed){note('owned-signal',{pid:owner.pid,signal:'SIGKILL'});try{owner.proc.kill('SIGKILL');await bounded('owned KILL exit and streams',()=>owner.closedPromise,killMs);}catch(e){errors.push(errorInfo(e));}}\n // A parent close cannot establish descendant profile quiescence. Retention is intentional.\n const profileRetained=owner.profile?{path:owner.profile,reason:'descendant quiescence not independently established'}:null;\n note('owned-cleanup-result',{pid:owner.pid,complete:owner.closed,exit:owner.exit,errors,profileRetained});\n return{complete:owner.closed,errors,profileRetained};\n}\nexport function assertExactOwner(owner,path){if(!owner||path!==owner.profile||lstatSync(path).isSymbolicLink()||realpathSync(path)!==owner.canonical)throw Error('Exact new profile ownership not established');return true;}\nexport async function finalizeEvidence({journal,status,summaryPath,finalizers=[],write=exclusiveWrite}){\n status.primaryError??=null;status.cleanupErrors??=[];status.persistenceErrors??=[];\n const persist=(name,value)=>{try{journal.record(name,value);}catch(e){status.persistenceErrors.push(errorInfo(e));}};\n persist('primary-outcome',JSON.parse(JSON.stringify(status)));\n for(const [name,operation] of finalizers){persist('cleanup-start',{finalizer:name});try{const outcome=await bounded(name,operation,5000);if(outcome?.errors?.length)status.cleanupErrors.push(...outcome.errors.map(error=>({finalizer:name,...error})));if(outcome?.complete===false)status.cleanupErrors.push({finalizer:name,message:'Cleanup incomplete'});persist('cleanup-complete',{finalizer:name,outcome});}catch(e){status.cleanupErrors.push({finalizer:name,...errorInfo(e)});persist('cleanup-error',{finalizer:name,...errorInfo(e)});}}\n status.persistenceErrors.push(...journal.persistenceErrors);\n if(status.primaryError||status.cleanupErrors.length||status.persistenceErrors.length)status.status='BLOCKED';\n persist('result',JSON.parse(JSON.stringify(status)));\n if(summaryPath)try{write(summaryPath,JSON.stringify(status,null,2)+'\\n');}catch(e){status.persistenceErrors.push(errorInfo(e));status.status='BLOCKED';persist('summary-write-failure',errorInfo(e));}\n try{journal.close();}catch(e){status.persistenceErrors.push(errorInfo(e));status.status='BLOCKED';}\n return status;\n}\nexport async function streamChild(command,args,{cwd,env,stdoutPath,stderrPath,record,spawnFn=spawn}){\n const out=openSync(stdoutPath,'wx');let err;\n try{err=openSync(stderrPath,'wx');}catch(e){closeSync(out);throw e;}\n const persistenceErrors=[];let stdout='',stderr='',proc,owner;\n const capture=(fd,b,kind)=>{try{writeAll(fd,b,{writeSync});fsyncSync(fd);}catch(e){persistenceErrors.push(errorInfo(e));}if(kind==='stdout')stdout+=b;else stderr+=b;};\n try{\n  record('child-spawn',{command,args,cwd,stdoutPath,stderrPath});proc=spawnFn(command,args,{cwd,env,stdio:['ignore','pipe','pipe']});owner=trackOwned(proc,null,record);\n  proc.stdout.on('data',b=>capture(out,b,'stdout'));proc.stderr.on('data',b=>capture(err,b,'stderr'));\n  const exit=await owner.closedPromise;const result={...exit,stdout,stderr,pid:owner.pid,startupError:owner.startupError,persistenceErrors};record('child-exit',result);return result;\n }finally{for(const fd of [out,err])try{fsyncSync(fd);}finally{closeSync(fd);}}\n}\nexport const Q1_UNITS=['focus-controls','reload-controls','appearance-fapp1','appearance-fapp2','appearance-accepted','apprail-accepted','geometry-reload-p0'];\nexport function nextReservation(unit,iteration,historical,current){\n if(!Q1_UNITS.includes(unit)||![1,2,3].includes(iteration))throw Error('Unregistered formal unit/cap');\n const entries=[...historical,...current].filter(x=>x.unit===unit),indices=entries.map(x=>x.iteration).sort();\n const minimum=unit==='focus-controls'?1:0;\n if(entries.length<minimum||new Set(indices).size!==indices.length||indices.some((n,i)=>n!==i+1)||entries.length>=3||iteration!==entries.length+1)throw Error('Permanent cumulative formal reservation refused');return entries.length;\n}\n/** Only existing raw structured details are used. Any unrelated failed precondition rejects. */\nexport function inducedCause(test,id,error,records,audit,trace){\n const failed=records.filter(r=>r.name==='check'&&r.kind==='precondition'&&!r.pass);\n if(!error||failed.length!==1||!audit?.length||!audit.every(x=>x.trusted)||!equal(audit.map(({type,key,shiftKey})=>({type,key,shiftKey})),trace))return{pass:false,reason:'missing cause, unrelated refusal or invalid trusted trace'};\n const f=failed[0],closure=id+':full-native-cycle-census-closure';let cause=false;\n if(test==='missing-stop')cause=f.id.startsWith(id+':census-unchanged-at-')&&f.initial?.length>f.census?.length&&f.initial.filter(n=>!f.census.some(c=>c.node===n.node)).length===1;\n else if(['duplicate-stop','excess-body','closure'].includes(test)&&f.id===closure){const visits=f.nodeVisits??[],body=(f.visited??[]).filter(x=>x==='body').length;cause=test==='duplicate-stop'?new Set(visits).size<visits.length:test==='excess-body'?body>1:!f.closed&&f.rows===1&&visits.length===2;}\n else if(f.id===id+':all-stops-valid-stable-attributable-captures'&&f.invalid?.length===1){\n  const r=f.invalid[0],a=r.first,b=r.again,m=a?.meta,n=b?.meta;const target=['outside:target','clock:target:'+test].includes(r.desc),view=m&&n&&['scale','width','height','dpr'].every(k=>m.window[k]===n.window[k]);\n  if(target&&view){\n   const windowChanged=!equal(m.window,n.window),ancestorsChanged=!equal(m.ancestors,n.ancestors),hoverChanged=!equal(m.hover,n.hover);\n   if(test==='scroll-drift')cause=windowChanged&&!ancestorsChanged&&!hoverChanged&&m.window.y!==n.window.y;\n   if(test==='ancestor-scroll')cause=!windowChanged&&ancestorsChanged&&!hoverChanged&&m.ancestors.some((x,i)=>x.node===n.ancestors[i]?.node&&(x.scrollTop!==n.ancestors[i]?.scrollTop||x.scrollLeft!==n.ancestors[i]?.scrollLeft));\n   if(test==='hover-drift')cause=!windowChanged&&!ancestorsChanged&&hoverChanged&&trace.length>0;\n   if(test==='next-overlap')cause=r.ambiguousNext===true&&r.targetMoved===false&&b.next?.node&&m.census.some(x=>x.node===b.next.node&&!equal(x.rect,b.next.rect));\n   if(test==='clipped')cause=r.targetMoved&&r.context&&r.union===null&&[a,b].some(p=>p.clip&&(p.clip.x<p.vis.left||p.clip.x+p.clip.width>p.vis.right||p.clip.y<p.vis.top||p.clip.y+p.clip.height>p.vis.bottom));\n   if(test==='partial-occluded'||test==='ring-occluded')cause=r.targetMoved&&r.context&&r.comparison?.fullyOccluded===false&&r.comparison?.occluded>0&&(m.occluders?.length>0||m.paintOverlaps?.length>0||m.nativeRingHits?.some(x=>x.chain?.some(y=>y.node!==m.node)));\n   // Existing invalid metadata lacks bounded capture attempts/hashes for instability. Refuse until separately scoped metadata exists.\n   if(test==='unstable')cause=false;\n  }\n }\n return{pass:!!cause,reason:cause?'exact induced cause preserved':'specific cause insufficient; freeze for impact review',failed};\n}\n"},"verify-evidence-retention.mjs":{"sha256":"445e322ac11a5fca4934e65e1de4910418289ede100104cc707dbe70ac7ee71c","source":"/** Deterministic correction validation. No browser, product, native, probe or package invocation. */\nimport assert from 'node:assert/strict';\nimport * as fs from 'node:fs';\nimport {join} from 'node:path';\nimport {tmpdir} from 'node:os';\nimport {fileURLToPath} from 'node:url';\nimport {createHash} from 'node:crypto';\nimport {spawn} from 'node:child_process';\nimport {createJournal,exclusiveWrite,readJournal,finalizeEvidence,trackOwned,closeOwned,streamChild,assertExactOwner,nextReservation,inducedCause,Q1_UNITS} from './evidence-retention.mjs';\nconst output=fileURLToPath(new URL('./',import.meta.url)),iteration=Number(process.argv[2]);\nassert([1,2,3].includes(iteration));\nfor(let i=1;i<iteration;i++)assert(fs.existsSync(join(output,`retention-checks-i${i}.json`)),'Previous validation receipt required');\nconst journal=createJournal(join(output,`retention-checks-i${iteration}.log`));\nconst sources=Object.fromEntries(['evidence-retention.mjs','verify-evidence-retention.mjs','verify-qualification.mjs'].map(n=>[n,{sha256:createHash('sha256').update(fs.readFileSync(join(output,n))).digest('hex'),source:fs.readFileSync(join(output,n),'utf8')}]));\njournal.record('validation-source-freeze',{iteration,sources,formal:0,probes:0,browserNative:0});\nconst scratch=fs.mkdtempSync(join(tmpdir(),'xai-retention-synthetic-')),cases=[];let checks=0;\nconst check=(condition,message)=>{checks++;assert(condition,message);};\nconst fail=message=>Object.assign(Error(message),{code:'INJECTED'});\nasync function test(name,run){journal.record('case-enter',{name});try{await run();cases.push({name,pass:true});journal.record('case-complete',{name,pass:true});}catch(e){cases.push({name,pass:false,error:e.stack});journal.record('case-complete',{name,pass:false,error:e.stack});}}\nconst path=n=>join(scratch,n);\nconst state=()=>({status:'AUTHOR_SYNTHETIC_PASS_UNQUALIFIED'});\ntry{\n await test('01-primary-plus-cleanup-failure',async()=>{const j=createJournal(path('primary.log')),s={...state(),primaryError:{message:'primary business observation'}},order=[];j.record('raw',{sequence:1});await finalizeEvidence({journal:j,status:s,summaryPath:path('primary.json'),finalizers:[['cleanup',()=>{order.push(readJournal(j.path).records.at(-2)?.name);throw fail('cleanup');}],['remaining',()=>{order.push('remaining');return{complete:true};}]]});check(s.primaryError.message==='primary business observation'&&s.cleanupErrors.length===1&&s.status==='BLOCKED','independent errors');check(order.includes('remaining')&&readJournal(j.path).records.some(x=>x.name==='primary-outcome'),'primary before remaining guarded finalizers');});\n await test('02-cleanup-only-failure',async()=>{const j=createJournal(path('cleanup.log')),s=state();j.record('business',{pass:true});await finalizeEvidence({journal:j,status:s,finalizers:[['cleanup',()=>{throw fail('cleanup only');}]]});check(s.primaryError===null&&s.cleanupErrors.length===1&&s.status==='BLOCKED','cleanup cannot replace business outcome');check(readJournal(j.path).records[0].pass===true,'business preserved');});\n await test('03-slow-no-exit-owned-signals',async()=>{const profile=fs.mkdtempSync(join(scratch,'owned-')),events=[],p=spawn(process.execPath,['-e',\"process.on('SIGTERM',()=>{});process.stdout.write('ready');setInterval(()=>{},1000)\"],{stdio:['ignore','pipe','pipe']}),o=trackOwned(p,profile,(name,value)=>events.push({name,...value}));await new Promise(r=>p.stdout.once('data',r));const started=Date.now(),result=await closeOwned(o,null,(name,value)=>events.push({name,...value}),{termMs:80,killMs:1000,closeMs:80});check(result.complete&&o.exit.signal==='SIGKILL','owned child actual close');check(Date.now()-started<5000&&events.filter(e=>e.name==='owned-signal').length===2,'finite signals');check(fs.existsSync(profile)&&result.profileRetained.path===profile,'uncertain profile retained');});\n await test('04-CDP-close-rejection',async()=>{const events=[],p=spawn(process.execPath,['-e','setInterval(()=>{},1000)'],{stdio:['ignore','pipe','pipe']}),o=trackOwned(p,null,(name,value)=>events.push({name,...value})),r=await closeOwned(o,()=>Promise.reject(fail('close rejection')),(name,value)=>events.push({name,...value}));check(r.complete&&r.errors.some(e=>e.message==='close rejection'),'close rejection secondary, owned exit retained');});\n await test('05-startup-before-handle',async()=>{const events=[],p=spawn(path('nonexistent-program'),[],{stdio:['ignore','pipe','pipe']}),o=trackOwned(p,null,(name,value)=>events.push({name,...value}));await o.closedPromise;check(o.closed&&o.startupError.code==='ENOENT'&&events.some(e=>e.name==='owned-acquired'),'failed startup tracked before returned handle');});\n await test('06-journal-and-result-write-failure',async()=>{let writes=0;const io={...fs,writeSync(...args){if(++writes>1)throw fail('journal write');return fs.writeSync(...args);}},j=createJournal(path('write-failure.log'),io),s=state(),finalizers=[];j.record('durable-before-fault',{pass:true});await finalizeEvidence({journal:j,status:s,summaryPath:path('write-failure.json'),write:()=>{throw fail('result write');},finalizers:[['remaining',()=>{finalizers.push(true);return{complete:true};}]]});check(s.status==='BLOCKED'&&s.persistenceErrors.length>0&&finalizers.length===1,'persistence independently fatal; remaining finalizer attempted');check(readJournal(j.path).records[0].name==='durable-before-fault','earlier raw survives failed later writes');});\n await test('07-stream-partial-child-nonzero-exit2',async()=>{const events=[],out=path('child-out.log'),err=path('child-err.log');const pending=streamChild(process.execPath,['-e',\"process.stdout.write('partial-out');process.stderr.write('partial-err');setTimeout(()=>process.exit(2),120)\"],{cwd:scratch,env:process.env,stdoutPath:out,stderrPath:err,record:(name,value)=>events.push({name,...value})});let seen=false;for(let i=0;i<50;i++){await new Promise(r=>setTimeout(r,5));if(fs.readFileSync(out,'utf8')==='partial-out'){seen=true;break;}}check(seen,'stdout streamed before close');const result=await pending;check(result.code===2&&result.signal===null&&fs.readFileSync(err,'utf8')==='partial-err','real historical exit2 and stderr preserved');check(result.persistenceErrors.length===0&&events.some(e=>e.name==='owned-streams-closed'),'stream closure retained');});\n await test('08-checkout-cleanup-failure',async()=>{const j=createJournal(path('checkout.log')),s=state(),order=[];j.record('child-exit',{code:2});await finalizeEvidence({journal:j,status:s,finalizers:[['checkout',()=>{check(readJournal(j.path).records.some(x=>x.name==='primary-outcome'),'primary persisted before checkout cleanup');throw fail('ENOTEMPTY checkout');}],['last',()=>{order.push('last');return{complete:true};}]]});check(order.length===1&&s.cleanupErrors[0].message==='ENOTEMPTY checkout'&&readJournal(j.path).records[0].code===2,'checkout cleanup cannot lose child exit');});\n await test('09-overwrite-refusal',async()=>{exclusiveWrite(path('no-overwrite'),Buffer.from('original'));assert.throws(()=>exclusiveWrite(path('no-overwrite'),'replacement'),e=>e.code==='EEXIST');checks++;check(fs.readFileSync(path('no-overwrite'),'utf8')==='original','no overwritten original');assert.throws(()=>createJournal(path('no-overwrite')),e=>e.code==='EEXIST');checks++;});\n await test('10-interrupted-tail-visible',async()=>{const j=createJournal(path('tail.log'));j.record('complete-before-tail',{pass:true});j.close();fs.appendFileSync(j.path,'{\"interrupted\":');const r=readJournal(j.path);check(!r.complete&&r.tail==='{\"interrupted\":'&&r.records.length===1,'incomplete tail exposed, no manufactured pass');});\n await test('11-permanent-cumulative-reservations',async()=>{const historical=[{unit:'focus-controls',iteration:1,status:'PREFLIGHT_PASSED'}];check(nextReservation('focus-controls',2,historical,[])===1,'new directory imports original focus1');assert.throws(()=>nextReservation('focus-controls',1,historical,[]));checks++;assert.throws(()=>nextReservation('focus-controls',1,[],[]));checks++;for(const unit of Q1_UNITS.slice(1))check(nextReservation(unit,1,historical,[])===0,'other six start0');assert.throws(()=>nextReservation('focus-controls',3,historical,[{unit:'focus-controls',iteration:2},{unit:'focus-controls',iteration:3}]));checks++;assert.throws(()=>nextReservation('focus-controls',2,historical,[{unit:'focus-controls',iteration:1}]));checks++;});\n await test('12-exact-ownership',async()=>{const profile=fs.mkdtempSync(join(scratch,'profile-')),o={profile,canonical:fs.realpathSync(profile)};check(assertExactOwner(o,profile),'exact synthetic own profile');assert.throws(()=>assertExactOwner(o,scratch));checks++;const link=path('profile-link');fs.symlinkSync(profile,link);assert.throws(()=>assertExactOwner({...o,profile:link},link));checks++;check(fs.existsSync(profile),'ownership refusal never deletes profile');});\n await test('13-unrelated-causal-refusal-rejected',async()=>{const audit=[{type:'keydown',key:'Tab',shiftKey:false,trusted:true}],trace=[{type:'keydown',key:'Tab',shiftKey:false}],records=[{name:'check',kind:'precondition',id:'case:all-stops-valid-stable-attributable-captures',pass:false,invalid:[{desc:'outside:next',first:{},again:{}}]}];check(!inducedCause('scroll-drift','case','PRECONDITION',records,audit,trace).pass,'unrelated failed target rejected');check(!inducedCause('unstable','case','PRECONDITION',records,audit,trace).pass,'insufficient bounded instability metadata blocked');const missing=[{name:'check',kind:'precondition',id:'case:census-unchanged-at-1',pass:false,initial:[{node:1},{node:2}],census:[{node:2}]}];check(inducedCause('missing-stop','case','PRECONDITION',missing,audit,trace).pass,'specific missing node census cause');check(!inducedCause('duplicate-stop','case','PRECONDITION',missing,audit,trace).pass,'missing is not duplicate');});\n await test('14-static-generated-adapter-source-freeze',async()=>{const argv=process.argv;process.argv=argv.slice(0,2);let driver;try{driver=await import('./verify-qualification.mjs');}finally{process.argv=argv;}const inventory=driver.inventory(),generated={};for(const ref of inventory.historical){const g=driver.historicalSource(ref);generated[ref.unit]=g;check(g.source.includes('q1Journal.record(name,value)')&&g.source.includes('trackOwned(proc,profile,q1Record)')&&g.source.includes('directory-retained'),'generated raw/ownership/retention adapter');}for(const phase of ['old','new']){const g=driver.geometrySource(phase);generated['geometry-'+phase]=g;check(g.source.includes('q1PrimaryExit')&&g.source.includes('q1Final.persistenceErrors'),'geometry preserves primary/secondary');}journal.record('generated-source-freeze',{generated,inventory});});\n}finally{\n // Only this exact newly created synthetic root is removed; no historical profile or glob.\n journal.record('synthetic-scratch-cleanup',{path:scratch,ownership:'exact mkdtemp returned path'});fs.rmSync(scratch,{recursive:true,force:true});\n const result={status:cases.every(x=>x.pass)?'CORRECTION_VALIDATION_PASS_UNQUALIFIED':'BLOCKED',iteration,cases,checks,formal:0,probes:0,browserNative:0,sourceHashes:Object.fromEntries(Object.entries(sources).map(([n,v])=>[n,v.sha256]))};\n journal.record('validation-result',result);journal.close();exclusiveWrite(join(output,`retention-checks-i${iteration}.json`),JSON.stringify(result,null,2)+'\\n');console.log(JSON.stringify(result));if(result.status==='BLOCKED')process.exitCode=1;\n}\n"},"verify-qualification.mjs":{"sha256":"18017e8a3d9d5ab49d263d1b00c8c0b383831288b432becba80b32e57f079a79","source":"/** Q1 isolated oracle qualification. UNQUALIFIED until separate Q2 PASS.\n * Native input is pipe CDP; retained screenshots are never rescaled or registered.\n * --calibrate only serves inert controls. No product or recovery implementation.\n */\nimport {createHash} from 'node:crypto';\nimport {inflateSync} from 'node:zlib';\nimport {isDeepStrictEqual} from 'node:util';\nimport {spawn,execFileSync} from 'node:child_process';\nimport {readFileSync,writeFileSync,existsSync,mkdtempSync,mkdirSync,readdirSync,rmSync} from 'node:fs';\nimport {createServer} from 'node:http';\nimport {fileURLToPath} from 'node:url';\nimport {join,dirname,resolve} from 'node:path';\nimport {tmpdir} from 'node:os';\nimport {createQualifiedPixelOracle} from './pixel-focus-qualified-r1.mjs';\nimport {createJournal,exclusiveWrite,trackOwned,closeOwned,finalizeEvidence,bounded,streamChild,nextReservation,inducedCause,errorInfo} from './evidence-retention.mjs';\nconst output=fileURLToPath(new URL('./',import.meta.url)),root=fileURLToPath(new URL('../../../',import.meta.url));\nconst P0='f9eb4b1f207bc4b46f547b90afc250424b3c8695',PARENT='710fd8421ed651ec366c5bb5e3b15fa5151ec7e6';\nconst sha256=b=>createHash('sha256').update(b).digest('hex');\nconst git=(...a)=>execFileSync('git',a,{cwd:root,maxBuffer:30*1024*1024});\nconst blockOf=source=>{const start=source.indexOf('\\n/** A minimal PNG decoder (8-bit')+1,fn=source.indexOf('\\nasync function pixelFocusWalk(',start)+1,end=source.indexOf('\\n}\\n',fn)+3;return{block:source.slice(start,end),fn:source.sl