{
  "name": "@repo/plugin-web-ai-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Chat module for XAI Web Console — collapsible conversation sidebar + 5-layer aurora + breathing orb + composer + starter prompts. Uses fail-closed provider policy semantics for chat send/test paths; no demo-success adapter fallback.",
  "sideEffects": ["./src/styles.css", "./src/index.ts"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/plugin-web-tokens": "workspace:*",
    "@repo/plugin-web-storage": "workspace:*",
    "@repo/web-auth-device-session": "workspace:*",
    "@repo/xai-web-event-bus": "workspace:*",
    "@repo/xai-web-shell": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "idb-keyval": "^6.2.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.1"
  }
}
