{
  "name": "@repo/xai-web-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web Console host shell — AppRail + Topbar + AvatarMenu + Module Slot Registry for XAI Web SPA.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/plugin-web-tokens": "workspace:*",
    "@repo/plugin-web-storage": "workspace:*",
    "@repo/xai-web-event-bus": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.15"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "^26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.15.1",
    "typescript": "5.9.2",
    "vitest": "^3.2.1"
  }
}
