{
  "name": "@repo/xai-web-event-bus",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-only typed event bus for the XAI Web SPA. Shares EventMap types with @repo/core; ships a native EventTarget runtime adapter for web:* channels.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@repo/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.1"
  }
}
