{
  "name": "organizer",
  "version": "1.0.0",
  "displayName": "智能桌面整理",
  "description": "Grid-based Smart Container file organizer mounted in the normal-window desktop runtime (overlay lifecycle is not required for row #20).",
  "author": "Jinlong",
  "enabled": true,
  "contentTypes": ["file-grid", "app-grid", "folder-grid", "normal-window-organizer"],
  "windows": {
    "overlay": false,
    "control": false,
    "grid": false,
    "console": false
  },
  "events": {
    "emit": [],
    "listen": []
  },
  "dependencies": ["@repo/core", "@repo/ui"],
  "tauriCommands": [
    "db_init",
    "db_get",
    "db_list",
    "db_put",
    "db_put_batch",
    "db_delete",
    "register_path_bookmark",
    "clear_path_bookmark",
    "reveal_in_finder",
    "open_path",
    "read_finder_tags"
  ]
}
