{
  "name": "account",
  "version": "0.1.0",
  "displayName": "账户与同步",
  "description": "Account login, logout and cross-device sync. Signup/login orchestration is in development; runtime UI remains disabled.",
  "author": "Jinlong",
  "enabled": false,
  "contentTypes": [],
  "windows": {},
  "events": {
    "emit": [
      "account:logged-in",
      "account:logged-out",
