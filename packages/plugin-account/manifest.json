    "listen": []
  },
  "dependencies": ["@repo/core", "@repo/core-data"],
  "tauriCommands": [
    "crypto_encrypt_for",
    "crypto_unwrap_dek_for_device",
    "crypto_wrap_dek_for_devices",
    "crypto_recovery_sign"
  ]
}
