{
  "name": "@repo/plugin-web-pet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Floating 8-character desktop pet with drag + tips + picker for the XAI Web Console.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@repo/plugin-web-storage": "workspace:*",
    "@repo/plugin-web-tokens": "workspace:*",
    "@repo/xai-web-event-bus": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
