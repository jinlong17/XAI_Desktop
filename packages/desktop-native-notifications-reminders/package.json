{
  "name": "@repo/desktop-native-notifications-reminders",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-safe desktop notification bridge and host-injected adapter contract for desktop runtime.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./web": {
      "types": "./src/web.ts",
      "import": "./src/web.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "node ../core/node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../core/node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/plugin-web-storage": "workspace:*",
    "@repo/plugin-web-tasks": "workspace:*",
    "@repo/plugin-web-calendar": "workspace:*",
    "@repo/xai-web-event-bus": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.2",
    "vitest": "^3.2.1"
  }
}
