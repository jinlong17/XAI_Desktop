{
  "name": "@repo/plugin-web-meditation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Meditation module for XAI Web Console (W2 row #16) — 5 scene gradients + 4 live clock variants + 5 ambient sounds + 5 durations + fullscreen player with rising particles + 8s breathing ring.",
  "sideEffects": [
    "./src/styles.css",
    "./src/index.ts",
    "./src/internal/accountMigration.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/plugin-web-storage": "workspace:*",
    "@repo/plugin-web-tokens": "workspace:*",
    "@repo/xai-web-shell": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "^26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
