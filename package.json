{
  "name": "XAI_Desktop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dashboard": "node scripts/dashboard/generate-state.mjs",
    "dashboard:open": "node scripts/dashboard/open.mjs",
    "dashboard:verify-static": "node scripts/dashboard/verify-static.mjs",
    "dashboard:verify-modules": "node scripts/dashboard/verify-product-modules.mjs",
    "dashboard:serve": "node scripts/dashboard/serve.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "pnpm check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/react-resizable": "^3.0.8",
    "cbor-x": "1.6.4",
    "flag": "^5.0.1",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
