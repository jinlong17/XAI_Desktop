{
  "name": "XAI_Desktop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "cloudflare:verify-token": "bash scripts/ci/check-cloudflare-pages-token.sh",
    "dashboard": "node scripts/dashboard/generate-state.mjs",
    "dashboard:open": "node scripts/dashboard/open.mjs",
    "dashboard:verify-static": "node scripts/dashboard/verify-static.mjs",
    "dashboard:verify-modules": "node scripts/dashboard/verify-product-modules.mjs",
    "dashboard:serve": "node scripts/dashboard/serve.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint && node scripts/web/check-design-colors.mjs",
    "web:check-colors": "node scripts/web/check-design-colors.mjs",
    "typecheck": "pnpm check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/react-resizable": "^3.0.8",
    "cbor-x": "1.6.4",
    "flag": "^5.0.1",
    "prettier": "^3.6.2",
    "turbo": "^2.9.16",
    "typescript": "5.9.2",
    "wrangler": "^4.107.1"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "ajv@6.12.6": "6.14.0",
      "brace-expansion@1.1.12": "1.1.13",
      "brace-expansion@2.0.2": "2.0.3",
      "esbuild": "0.28.1",
      "flatted": "3.4.2",
      "form-data": "4.0.6",
      "js-yaml@4.1.0": "4.2.0",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.5": "9.0.7",
      "next>postcss": "8.5.15",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.4",
      "postcss": "8.5.15",
      "rollup": "4.62.2",
      "undici@7.24.8": "7.28.0",
      "undici@7.25.0": "7.28.0",
      "ws": "8.21.0"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
