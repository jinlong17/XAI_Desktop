{
  "name": "@repo/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "dev:mock-auth": "VITE_WEB_AUTH_MODE=mock-authenticated vite --port 3000",
    "build": "vite build",
    "build:secure": "vite build && pnpm run sourcemaps:release:create && pnpm run sourcemaps:release:set-commits && pnpm run sourcemaps:debugids:inject && pnpm run sourcemaps:upload && pnpm run sourcemaps:validate && pnpm run sourcemaps:finalize && pnpm run sourcemaps:clean && pnpm run sourcemaps:assert-clean",
    "build:secure:with-deploy": "pnpm run build:secure && pnpm run sourcemaps:deploy:mark",
    "lint": "eslint --max-warnings 0 .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --port 4173",
    "sourcemaps:release:create": "node ./scripts/sourcemaps-release-create.mjs",
    "sourcemaps:release:set-commits": "node ./scripts/sourcemaps-release-set-commits.mjs",
    "sourcemaps:debugids:inject": "node ./scripts/sourcemaps-debugids-inject.mjs",
    "sourcemaps:upload": "node ./scripts/sourcemaps-upload.mjs",
    "sourcemaps:validate": "node ./scripts/sourcemaps-validate.mjs",
    "sourcemaps:finalize": "node ./scripts/sourcemaps-finalize.mjs",
    "sourcemaps:clean": "node ./scripts/sourcemaps-clean.mjs",
    "sourcemaps:assert-clean": "node ./scripts/sourcemaps-assert-clean.mjs",
    "sourcemaps:deploy:mark": "node ./scripts/sourcemaps-deploy-mark.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.20.0",
    "@repo/core": "workspace:^",
    "@repo/plugin-web-tokens": "workspace:*",
    "@repo/plugin-web-storage": "workspace:*",
    "@repo/xai-web-shell": "workspace:*",
    "@repo/xai-web-cmdk": "workspace:*",
    "@repo/plugin-web-pet": "workspace:*",
    "@repo/plugin-web-board-core": "workspace:*",
    "@repo/plugin-web-board-views": "workspace:*",
    "@repo/plugin-web-board-workspaces": "workspace:*",
    "@repo/plugin-web-countdown": "workspace:*",
    "@repo/plugin-web-dashboard-grid": "workspace:*",
    "@repo/plugin-web-dashboard-widgets": "workspace:*",
    "@repo/plugin-web-matrix": "workspace:*",
    "@repo/plugin-web-pomodoro": "workspace:*",
    "@repo/plugin-web-habits": "workspace:*",
    "@repo/plugin-web-ai-chat": "workspace:*",
    "@repo/plugin-web-meditation": "workspace:*",
    "@repo/plugin-web-calendar": "workspace:*",
    "@repo/plugin-web-tasks": "workspace:*",
    "@repo/plugin-web-statistics": "workspace:*",
    "@repo/plugin-web-time-tracker": "workspace:*",
    "@repo/plugin-web-bookkeeping": "workspace:*",
    "@repo/plugin-web-settings-shell": "workspace:*",
    "@repo/plugin-web-settings-features-panel": "workspace:*",
    "@repo/plugin-web-settings-appearance": "workspace:*",
    "@repo/plugin-web-settings-rest": "workspace:*",
    "@repo/plugin-console": "workspace:^",
    "@repo/plugin-productivity": "workspace:^",
    "@repo/web-auth-device-session": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.15.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/xai-web-event-bus": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "typescript": "5.9.2",
    "vite": "^7.0.4",
    "vitest": "^3.2.1"
  }
}
