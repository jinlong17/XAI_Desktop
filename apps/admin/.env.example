# apps/admin — environment variable template
# Copy to .env.local for local development. Never commit real secrets.
#
# Auth posture: mock-authenticated (slice #1, ADR-lite #3 / design.md assumption #3).
# Real Supabase device-session auth is wired in a later row following ADR-0008 extension protocol.
#
# VITE_ADMIN_MOCK_CLAIM=true
#   When set to "true", the mockAdminClaimPredicate treats any authenticated session
#   as an admin session. Used for local development only; never set in production.
#   See apps/admin/src/auth/adminClaim.ts.
VITE_ADMIN_MOCK_CLAIM=true

# VITE_ADMIN_AUTH_MODE — reserved for row #2 (real auth wiring).
# Do NOT set this to anything other than "mock-authenticated" for slice #1.
VITE_ADMIN_AUTH_MODE=mock-authenticated
