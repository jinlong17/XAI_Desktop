{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@repo/core": ["../../packages/core/src/index"],
      "@repo/core/events": ["../../packages/core/src/events/index"],
      "@repo/core/hooks": ["../../packages/core/src/hooks/index"],
      "@repo/core/registry": ["../../packages/core/src/registry/index"],
      "@repo/core/types": ["../../packages/core/src/types/index"],
      "@repo/core-data": ["../../packages/core-data/src/index"],
      "@repo/plugin-console": ["../../packages/plugin-console/src/index"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
