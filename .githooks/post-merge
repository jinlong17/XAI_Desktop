#!/usr/bin/env bash
# Dashboard auto-refresh on merge.
# Regenerates the dev-dashboard snapshot (docs/prototypes/dev-dashboard/
# state.generated.js, gitignored) so the board reflects the merged state.
# Only active when core.hooksPath=.githooks (see .githooks/README.md).
cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0
node scripts/dashboard/generate-state.mjs >/dev/null 2>&1 || true
exit 0
